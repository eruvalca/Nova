{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/eng/hooks.mjs\" --provider codex --event edit",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/eng/hooks.mjs\" --provider codex --event stop",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/eng/hooks.mjs\" --provider codex --event start",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/eng/hooks.mjs\" --provider codex --event prompt",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
