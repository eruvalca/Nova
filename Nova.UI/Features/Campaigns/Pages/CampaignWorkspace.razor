@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubMember)]
@using Microsoft.AspNetCore.Authorization
@using Nova.SharedKernel.Enums
@using Nova.SharedKernel.Security
@using Nova.UI.Features.Campaigns.Services
@using Nova.UI.Features.Campaigns.Components

<PageTitle>@(_detail is null ? "Campaign workspace" : _detail.Name)</PageTitle>

<!--
THESIS: A searchable participant field and adjacent context keep club staff oriented while working.
OWN-WORLD: Fieldhouse semantic teal, sea-glass navigation, white boards, system typography and hairlines.
STORY: Confirm campaign authority, find a participant, distinguish local outcomes from effective placement, capture observations, continue.
FIRST VIEWPORT: Compact identity and complete route precede readiness; a broad roster sits beside narrower participant context.
FORM: Roster beside participant context, ranked fifth; seed 16fb136e.
-->
<div class="campaign-field" @ref="_workspaceElement" data-workspace-owner="@_jsOwner">
    <a class="campaign-back-link" href="/campaigns"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4" /></svg> Back to campaigns</a>

    @if (_isLoading)
    {
        <div class="campaign-status-board">
            <div class="campaign-status-board-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading campaign...</span>
            </div>
        </div>
    }
    else if (_notFound)
    {
        <div class="campaign-status-board">
            <div class="campaign-status-board-body text-center py-5">
                <h1 class="h4 mb-2">Campaign not found</h1>
                <p class="text-muted mb-3">This campaign does not exist or is not visible to your club.</p>
                <a class="btn btn-outline-secondary btn-sm" href="/campaigns">Return to campaigns</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else if (_detail is not null)
    {
        <div class="workspace-orientation"><section class="campaign-sign">
            <div class="campaign-sign-body">
                <h1>@_detail.Name</h1>
                <div class="campaign-season">@_detail.SeasonName <span aria-hidden="true">·</span>
                    <span class="campaign-lifecycle">@_detail.Status</span>
                </div>
                <div class="campaign-facts-row">
                    <dl class="campaign-facts">
                        <div><dt class="visually-hidden">Dates</dt><dd>@FormatCampaignDates(_detail)</dd></div>
                        <div><dt class="visually-hidden">Participants</dt><dd>@(_campaignParticipantCount ?? _detail.ParticipantCount) participants</dd></div>
                    </dl>
                    <CampaignMenu Compact="true" IsClubAdmin="@_isClubAdmin" IsClosed="@(_detail.Status == CampaignStatus.Closed)"
                                  OnEditMetadata="BeginEditMetadataAsync" OnCloseCampaign="SelectCloseTabAsync"
                                  OnReopen="SelectCloseTabAsync" />
                </div>
            </div>
        </section>
                <nav class="campaign-route" aria-label="Campaign workspace routes" @ref="_campaignRoute">
                    <ul class="nav-tabs route-marker-list">
                        <li>
                            <a class="nav-link route-marker @(_activeTab == RosterTabName ? "active" : null)"
                               href="@BuildRosterUrl(_filters, RosterTabName, _selectedParticipantId, useRosterLanding: true)"
                               aria-current="@(_activeTab == RosterTabName ? "page" : null)">
                                <span class="route-marker-stop" aria-hidden="true"></span>
                                <span class="route-marker-label">Roster</span>
                                <span class="route-marker-state">Participant field</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-link route-marker @(_activeTab == EvaluateTabName ? "active" : null)"
                               href="@EvaluationUrl"
                               aria-current="@(_activeTab == EvaluateTabName ? "page" : null)">
                                <span class="route-marker-stop" aria-hidden="true"></span>
                                <span class="route-marker-label">Evaluate</span>
                                <span class="route-marker-state">Observations</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-link route-marker @(_activeTab == PlaceTabName ? "active" : null)"
                               href="@PlaceUrl"
                               aria-current="@(_activeTab == PlaceTabName ? "page" : null)">
                                <span class="route-marker-stop" aria-hidden="true"></span>
                                <span class="route-marker-label">Place</span>
                                <span class="route-marker-state">Assignments</span>
                            </a>
                        </li>
                        <li>
                            <a class="nav-link route-marker @(_activeTab == CloseTabName ? "active" : null)"
                               href="@CloseUrl"
                               aria-current="@(_activeTab == CloseTabName ? "page" : null)">
                                <span class="route-marker-stop" aria-hidden="true"></span>
                                <span class="route-marker-label">Close</span>
                                <span class="route-marker-state">Readiness</span>
                            </a>
                        </li>
                    </ul>
                </nav></div>
        <CampaignWorkspaceReadiness CampaignId="CampaignId" Status="_detail.Status" Owner="@($"{_authorityScope}:{_detailSequence}")"
            CloseDestination="@CloseUrl"
            OnLifecycleChanged="OnCampaignReloadRequestedAsync" />

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
        }

        @if (_editCampaignForm is not null)
        {
            <div class="mb-3">
                <CampaignMetadataForm Heading="Edit campaign metadata" Model="_editCampaignForm"
                                      Seasons="_editFormSeasonChoices" TotalSeasonCount="_seasonChoiceTotalCount" SubmitButtonText="Save changes"
                                      IsSubmitting="_isMutating" ErrorMessage="@_mutationError" OnValidSubmit="UpdateMetadataAsync"
                                      OnCancel="CancelMutationForm" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_mutationError))
        {
            <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" role="alert">
                <span>@_mutationError</span>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="BeginEditMetadataAsync">Retry</button>
            </div>
        }

        @if (_mutationConflict)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"
                 role="alert">
                <span>The save was rejected due to a conflict. Close the form and reload to see the current state before trying
                    again.</span>
                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="CloseFormAndReloadAsync">Close and reload</button>
                    </div>
                }



                @if (_activeTab == RosterTabName)
                {
                    <div class="roster-context-layout"><section class="workspace-board" aria-labelledby="roster-region-heading">
                        <h2 class="visually-hidden" id="roster-region-heading" tabindex="-1" @ref="_rosterHeading">Roster</h2>
                        @if (_openingReceiptMessage is not null)
                        {
                            <p class="opening-receipt" role="status">@_openingReceiptMessage <a href="@EvaluationUrl">Continue to evaluation</a></p>
                        }                            <div class="workspace-board-body">

                                @if (_choicesLoadFailed)
                                {
                                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2"
                                         role="alert">
                                        <span>Couldn't load filter options.</span>
                                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="RetryChoicesAsync">Retry</button>
                                    </div>
                                }

                                <CampaignRosterFilters ShowEligibility="@(_detail.Status == CampaignStatus.Active)" Eligibility="@_filters.Eligibility" EligibilityCounts="_eligibilityCounts" OnEligibilityChanged="OnEligibilityChangedAsync" TeamSearch="@_teamSearch" TeamChoicesTruncated="_teamChoicesTruncated" OnTeamSearchChanged="OnTeamSearchChangedAsync" SearchText="@_searchDraft" GraduationYearChoices="@_availableGraduationYears"
                                                       SelectedGraduationYears="@_filters.GraduationYears" TagChoices="@_availableTags"
                                                       SelectedTagDefinitionIds="@_filters.TagDefinitionIds" Outcome="@_filters.Outcome"
                                                       TeamChoices="@_availableTeams" TeamId="@_filters.TeamId"

                                                       OnSearchTextChanged="OnSearchInputChangedAsync" OnGraduationYearToggled="OnGraduationYearToggledAsync"
                                                       OnTagToggled="OnTagToggledAsync" OnOutcomeChanged="OnOutcomeChangedAsync"
                                                       OnTeamChanged="OnTeamChangedAsync" />

                                @if (_rosterLoading)
                                {
                                    <div class="d-flex align-items-center gap-2 mt-3">
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Loading roster...</span>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(_rosterError))
                                {
                                    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3"
                                         role="alert">
                                        <span>@_rosterError</span>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryRosterAsync">Retry</button>
                                    </div>
                                }
                                @if (_roster is not null && !_rosterLoading)
                                {
                                    @if (_roster.TotalCount == 0)
                                    {
                                        <div class="text-center py-5 mt-3">
                                            @if (HasActiveFilters)
                                            {
                                                <p class="text-muted mb-3">No participants match the current filters.</p>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OnClearFiltersAsync">Clear
                                                    filters</button>
                                                }
                            else
                                                {
                                                    <p class="text-muted mb-0">No participants in this campaign yet.</p>
                                                }
                                            </div>
                                        }
                    else
                                        {
                                            <div class="roster-scroll-region" @ref="_rosterScrollRegion" tabindex="-1">
                                                <CampaignRosterTable WorkingRows="@(_detail.Status == CampaignStatus.Active ? _workingRows : null)" Items="@_roster.Items" SortBy="@_filters.SortBy"
                                                                     SortDirection="@_filters.SortDirection" SelectedParticipantId="@_selectedParticipantId"
                                                                     OnParticipantSelected="OnParticipantSelectedAsync" OnSortChanged="OnSortChangedAsync" />
                                                <CampaignRosterCards WorkingRows="@(_detail.Status == CampaignStatus.Active ? _workingRows : null)" Items="@_roster.Items" SelectedParticipantId="@_selectedParticipantId"
                                                                     OnParticipantSelected="OnParticipantSelectedAsync" />
                                            </div>

                                        }
                                    }
                                    <CampaignRosterFooter TotalCount="@(_rosterLoading ? null : _roster?.TotalCount)" IsLoading="_rosterLoading"
                                        HasActiveFilters="HasActiveFilters" SortBy="@_filters.SortBy" SortDirection="@_filters.SortDirection"
                                        Page="_filters.Page" PageSize="RosterPageSize" OnPageChanged="OnPageChangedAsync"
                                        OnOrderChanged="OnOrderChangedAsync" OnClearFilters="OnClearFiltersAsync" />
                                </div>
                            </section>
                        @if (_selectedParticipantId is not null)
                        {
                            <CampaignParticipantDrawer CaptureScope="@_captureScope" CampaignId="@CampaignId" ParticipantId="_selectedParticipantId.Value"
                                                       WorkingRow="@_workingRows.FirstOrDefault(row => row.PlayerCampaignAssignmentId == _selectedParticipantId)" RosterItem="@SelectedRosterItem" AuthorizedStatus="_detail.Status" AuthorityScope="@_authorityScope" OnDataChanged="OnParticipantDataChangedAsync" OnLifecycleChanged="OnCampaignReloadRequestedAsync" Position="@SelectedParticipantPosition" TotalCount="@ParticipantSequenceCount"
                                                       HasPrevious="@HasPreviousParticipant" HasNext="@HasNextParticipant" OnPrevious="OnPreviousParticipantAsync"
                                                       OnNext="OnNextParticipantAsync" OnClose="OnCloseParticipantAsync" />
                        }
                        else
                        {
                            <aside class="participant-context-placeholder"><h2>Participant context</h2><p>Select a participant to review placement evidence, notes, and tags.</p></aside>
                        }
                        </div>
                        }
        else if (_activeTab == PlaceTabName)
                        {
                            <CampaignPlacePanel CampaignId="@CampaignId" CampaignStatus="@(_detail?.Status ?? CampaignStatus.Closed)"
                                                SelectedParticipantId="PlacementParticipantQuery"
                                                EvaluationReturnPath="@(ReturnToEvaluationQuery == true ? EvaluationUrl : null)"
                                                CanEditPlacements="@_canEditPlacements" State="@_placementState"
                                                GraduationYearChoices="_availableGraduationYears" TagChoices="_availableTags"
                                                CampaignTeamChoices="_availableTeams" CampaignTeamChoicesTruncated="_teamChoicesTruncated"
                                                ChoicesLoadFailed="_choicesLoadFailed" OnRetryChoices="RetryChoicesAsync"
                                                Owner="@($"{_authorityScope}:{CampaignId}")"
                                                OnStateChanged="OnPlacementStateChangedAsync" OnSelectionChanged="OnPlaceSelectionChangedAsync"
                                                OnReloadRequested="OnCampaignReloadRequestedAsync" />
                        }
                        else if (_activeTab == EvaluateTabName)
                        {
                            <CampaignEvaluationPanel CaptureScope="@_captureScope" CampaignId="CampaignId" Status="_detail.Status" AuthorityScope="@_authorityScope" State="EvaluationState" RosterState="_filters" RosterParticipantId="_selectedParticipantId" OnLifecycleChanged="OnCampaignReloadRequestedAsync" />
                        }
                        else if (_activeTab == CloseTabName)
                        {
                            <CampaignCloseoutPanel CampaignId="@CampaignId" Detail="@_detail" IsClubAdmin="@_isClubAdmin"
                                                   OnReviewUnresolved="OnReviewUnresolvedAsync" OnCancel="OnCancelCloseoutAsync"
                                                   OnReloadRequested="OnCampaignReloadRequestedAsync" />
                        }


                    }
                </div>
