@page "/campaigns/{CampaignId:long}"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubMember)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Enums
@using Nova.Shared.Security
@using Nova.UI.Features.Campaigns.Components

<PageTitle>@(_detail is null ? "Campaign workspace" : _detail.Name)</PageTitle>

<div class="container py-4">
    <a class="btn btn-outline-secondary btn-sm mb-3" href="/campaigns">← Back to campaigns</a>

    @if (_isLoading)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading campaign...</span>
            </div>
        </div>
    }
    else if (_notFound)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h1 class="h4 mb-2">Campaign not found</h1>
                <p class="text-muted mb-3">This campaign does not exist or is not visible to your club.</p>
                <a class="btn btn-outline-secondary btn-sm" href="/campaigns">Return to campaigns</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else if (_detail is not null)
    {
        <section class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div>
                        <h1 class="h3 mb-1">@_detail.Name</h1>
                        <p class="text-muted mb-0">
                            @FormatCampaignDates(_detail) · @_detail.SeasonName · @_detail.ParticipantCount participants
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @CampaignStatusBadgeClass(_detail.Status)">@_detail.Status</span>
                        <CampaignMenu IsClubAdmin="@_isClubAdmin"
                                      IsClosed="@(_detail.Status == CampaignStatus.Closed)"
                                      OnEditMetadata="BeginEditMetadataAsync"
                                      OnCloseCampaign="SelectCloseoutTabAsync"
                                      OnReopen="SelectCloseoutTabAsync" />
                    </div>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
        }

        @if (_editCampaignForm is not null)
        {
            <div class="mb-3">
                <CampaignMetadataForm Heading="Edit campaign metadata"
                                      Model="_editCampaignForm"
                                      Seasons="_editFormSeasonChoices"
                                      TotalSeasonCount="_seasonChoiceTotalCount"
                                      SubmitButtonText="Save changes"
                                      IsSubmitting="_isMutating"
                                      ErrorMessage="@_mutationError"
                                      OnValidSubmit="UpdateMetadataAsync"
                                      OnCancel="CancelMutationForm" />
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_mutationError))
        {
            <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" role="alert">
                <span>@_mutationError</span>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="BeginEditMetadataAsync">Retry</button>
            </div>
        }

        @if (_mutationConflict)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" role="alert">
                <span>The save was rejected due to a conflict. Close the form and reload to see the current state before trying again.</span>
                <button type="button" class="btn btn-sm btn-outline-warning" @onclick="CloseFormAndReloadAsync">Close and reload</button>
            </div>
        }

        <ul class="nav nav-tabs mb-3" role="tablist" aria-label="Campaign workspace sections">
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_activeTab == EvaluateTabName ? "active" : null)" role="tab" aria-selected="@(_activeTab == EvaluateTabName ? "true" : "false")" @onclick="SelectEvaluateTabAsync">
                    Evaluate
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_activeTab == PlacementsTabName ? "active" : null)" role="tab" aria-selected="@(_activeTab == PlacementsTabName ? "true" : "false")" @onclick="SelectPlacementsTabAsync">
                    Placements
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_activeTab == OverviewTabName ? "active" : null)" role="tab" aria-selected="@(_activeTab == OverviewTabName ? "true" : "false")" @onclick="SelectOverviewTabAsync">
                    Overview
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button" class="nav-link @(_activeTab == CloseoutTabName ? "active" : null)" role="tab" aria-selected="@(_activeTab == CloseoutTabName ? "true" : "false")" @onclick="SelectCloseoutTabAsync">
                    Closeout
                </button>
            </li>
        </ul>

        @if (_activeTab == EvaluateTabName)
        {
            <section class="card shadow-sm border-0" aria-labelledby="roster-region-heading">
                <div class="card-body">
                    <h2 class="h5 mb-3" id="roster-region-heading">Evaluate roster</h2>

                @if (_choicesLoadFailed)
                {
                    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
                        <span>Couldn't load filter options.</span>
                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="RetryChoicesAsync">Retry</button>
                    </div>
                }

                <CampaignRosterFilters SearchText="@_searchDraft"
                                       GraduationYearChoices="@_availableGraduationYears"
                                       SelectedGraduationYears="@_filters.GraduationYears"
                                       TagChoices="@_availableTags"
                                       SelectedTagDefinitionIds="@_filters.TagDefinitionIds"
                                       Outcome="@_filters.Outcome"
                                       TeamChoices="@_availableTeams"
                                       TeamId="@_filters.TeamId"
                                       TotalCount="@(_rosterLoading ? null : _roster?.TotalCount)"
                                       HasActiveFilters="@HasActiveFilters"
                                       OnSearchTextChanged="OnSearchInputChangedAsync"
                                       OnGraduationYearToggled="OnGraduationYearToggledAsync"
                                       OnTagToggled="OnTagToggledAsync"
                                       OnOutcomeChanged="OnOutcomeChangedAsync"
                                       OnTeamChanged="OnTeamChangedAsync"
                                       OnClearFilters="OnClearFiltersAsync" />

                @if (_rosterLoading)
                {
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Loading roster...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_rosterError))
                {
                    <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3" role="alert">
                        <span>@_rosterError</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryRosterAsync">Retry</button>
                    </div>
                }
                else if (_roster is not null)
                {
                    @if (_roster.TotalCount == 0)
                    {
                        <div class="text-center py-5 mt-3">
                            @if (HasActiveFilters)
                            {
                                <p class="text-muted mb-3">No participants match the current filters.</p>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="OnClearFiltersAsync">Clear filters</button>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No participants in this campaign yet.</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="roster-scroll-region" @ref="_rosterScrollRegion" tabindex="-1">
                            <CampaignRosterTable Items="@_roster.Items"
                                                 SortBy="@_filters.SortBy"
                                                 SortDirection="@_filters.SortDirection"
                                                 SelectedParticipantId="@_selectedParticipantId"
                                                 OnParticipantSelected="OnParticipantSelectedAsync"
                                                 OnSortChanged="OnSortChangedAsync" />
                            <CampaignRosterCards Items="@_roster.Items"
                                                 SelectedParticipantId="@_selectedParticipantId"
                                                 OnParticipantSelected="OnParticipantSelectedAsync" />
                        </div>
                        <CampaignRosterPager Page="@_roster.Page"
                                             PageSize="@_roster.PageSize"
                                             TotalCount="@_roster.TotalCount"
                                             OnPageChanged="OnPageChangedAsync" />
                    }
                }
            </div>
        </section>
        }
        else if (_activeTab == PlacementsTabName)
        {
            <CampaignPlacementsPanel CampaignId="@CampaignId"
                                     CampaignStatus="@(_detail?.Status ?? CampaignStatus.Closed)"
                                     CanEditPlacements="@_canEditPlacements"
                                     State="@_placementState"
                                     OnStateChanged="OnPlacementStateChangedAsync"
                                     OnReloadRequested="OnCampaignReloadRequestedAsync" />
        }
        else if (_activeTab == OverviewTabName)
        {
            <CampaignOverviewPanel CampaignId="@CampaignId"
                                   Detail="@_detail"
                                   IsClubAdmin="@_isClubAdmin"
                                   OnOpenCloseout="OnOpenCloseoutAsync" />
        }
        else if (_activeTab == CloseoutTabName)
        {
            <CampaignCloseoutPanel CampaignId="@CampaignId"
                                   Detail="@_detail"
                                   IsClubAdmin="@_isClubAdmin"
                                   OnReviewUnresolved="OnReviewUnresolvedAsync"
                                   OnCancel="OnCancelCloseoutAsync"
                                   OnReloadRequested="OnCampaignReloadRequestedAsync" />
        }

        @if (_selectedParticipantId is not null)
        {
            <CampaignParticipantDrawer CampaignId="@CampaignId"
                                       ParticipantId="_selectedParticipantId.Value"
                                       RosterItem="@SelectedRosterItem"
                                       Position="@SelectedParticipantPosition"
                                       TotalCount="@ParticipantSequenceCount"
                                       HasPrevious="@HasPreviousParticipant"
                                       HasNext="@HasNextParticipant"
                                       OnPrevious="OnPreviousParticipantAsync"
                                       OnNext="OnNextParticipantAsync"
                                       OnClose="OnCloseParticipantAsync" />
        }
    }
</div>
