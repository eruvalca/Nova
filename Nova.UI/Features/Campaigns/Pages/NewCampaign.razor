@page "/campaigns/new"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubAdmin)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Security
@using Nova.UI.Features.Campaigns.Components

<PageTitle>Create campaign</PageTitle>

<div class="container py-4">
    <div class="mb-3">
        <a href="campaigns" class="text-decoration-none">&larr; Back to campaigns</a>
    </div>

    <h1 class="mb-3">Create campaign</h1>

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ReloadAsync">Retry</button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading creation setup...</span>
            </div>
        </div>
    }
    else if (_setup is not null)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h2 class="h6 mb-2">Current enrollment preview</h2>
                <p class="mb-1">
                    <strong>@_setup.ActivePlayerCount</strong> active players will be enrolled as participants.
                </p>
                <p class="mb-0">
                    <strong>@_setup.ActiveTeamCount</strong> active teams will be available for placement.
                </p>
            </div>
        </div>

        <div class="alert alert-info" role="note">
            The campaign becomes <strong>Active</strong> immediately upon creation. The planned end date is
            informational and does not close the campaign.
        </div>

        @if (_setup.TotalSeasonCount > _setup.Seasons.Count)
        {
            <div class="alert alert-info" role="status">
                Only the newest @_setup.Seasons.Count of @_setup.TotalSeasonCount seasons are available for
                selection. Choose a listed season or create a new one inline.
            </div>
        }

        <CampaignCreateForm Heading="Campaign details"
                            Model="_createForm"
                            Seasons="_setup.Seasons"
                            SubmitButtonText="Create campaign"
                            IsSubmitting="_isSubmitting"
                            ErrorMessage="@_formError"
                            OnValidSubmit="CreateCampaignAsync"
                            OnCancel="Cancel" />
    }
</div>
