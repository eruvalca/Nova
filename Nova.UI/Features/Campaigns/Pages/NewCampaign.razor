@page "/campaigns/new"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubAdmin)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Security
@using Nova.UI.Features.Campaigns.Components

<PageTitle>Create campaign</PageTitle>
<!-- THESIS: Save essentials as a Draft before making any enrollment commitment.
OWN-WORLD: Flat working sheet within the approved Details and readiness system.
STORY: Name the campaign, confirm the current season, save preparation.
FIRST VIEWPORT: Campaign essentials and a clear saved-Draft consequence.
FORM: Main-column form; opening review belongs to the saved Draft. -->

<div class="container py-4">
    <div class="mb-3">
        <a href="/campaigns" class="text-decoration-none"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7M5 12h14" /></svg> Back to campaigns</a>
    </div>

    <h1 class="mb-3">Create campaign</h1>

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ReloadAsync">Retry</button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="border rounded p-3">
            <div class="card-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading creation setup...</span>
            </div>
        </div>
    }
    else if (_setup is not null)
    {
        <div class="border rounded p-3 mb-3">
            <div class="card-body">
                <h2 class="h6 mb-2">Current enrollment preview</h2>
                <p class="mb-1">
                    <strong>@_setup.ActivePlayerCount</strong> active @(_setup.ActivePlayerCount == 1 ? "player" : "players") will enroll when you open the campaign.
                </p>
                <p class="mb-0">
                    <strong>@_setup.ActiveTeamCount</strong> active @(_setup.ActiveTeamCount == 1 ? "team" : "teams") will be available for placement.
                </p>
            </div>
        </div>

        <div class="alert alert-info" role="note">
            Saving creates a <strong>Draft</strong>. Review preparation and explicitly open it to enroll players.
            Dates never open or close a campaign automatically.
        </div>

        @if (_pending is not null)
        {
            <div class="alert alert-warning" role="status">A previous creation request needs confirmation. Your original input is preserved.
                <button class="btn btn-primary" disabled="@(_isSubmitting || !_sessionReady)" @onclick="RecoverAsync">Confirm creation result</button>
            </div>
        }
        @if (_storageSaveFailed)
        {
            <button type="button" class="btn btn-outline-primary mb-3" disabled="@_isSubmitting" @onclick="RetryStorageAsync">Retry recovery storage</button>
        }
        <fieldset disabled="@(!_sessionReady || _pending is not null)">
        <CampaignCreateForm Heading="Campaign details"
                            Model="_createForm"
                            Seasons="@(_setup.CurrentSeason is null ? [] : [_setup.CurrentSeason])"
                            AllowInlineSeasonCreation="@(_setup.CurrentSeason is null)"
                            SubmitButtonText="Create campaign"
                            IsSubmitting="_isSubmitting"
                            ErrorMessage="@_formError"
                            ServerErrors="_fieldErrors"
                            OnChanged="SaveInputAsync"
                            OnValidSubmit="CreateCampaignAsync"
                            OnCancel="Cancel" />
        </fieldset>
    }
</div>
