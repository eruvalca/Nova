@using System.Globalization
@using Nova.Shared.Features.Campaigns

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Campaign roster participants</caption>
        <thead>
            <tr>
                <th scope="col" aria-sort="@AriaSort("tryoutNumber")">
                    <button type="button" class="btn btn-link p-0 text-decoration-none roster-sort-header" @onclick='() => ToggleSortAsync("tryoutNumber")'>
                        Tryout #<span class="roster-sort-arrow" aria-hidden="true">@SortArrow("tryoutNumber")</span>
                    </button>
                </th>
                <th scope="col" aria-sort="@AriaSort("displayName")">
                    <button type="button" class="btn btn-link p-0 text-decoration-none roster-sort-header" @onclick='() => ToggleSortAsync("displayName")'>
                        Name<span class="roster-sort-arrow" aria-hidden="true">@SortArrow("displayName")</span>
                    </button>
                </th>
                <th scope="col" aria-sort="@AriaSort("graduationYear")">
                    <button type="button" class="btn btn-link p-0 text-decoration-none roster-sort-header" @onclick='() => ToggleSortAsync("graduationYear")'>
                        Grad year<span class="roster-sort-arrow" aria-hidden="true">@SortArrow("graduationYear")</span>
                    </button>
                </th>
                <th scope="col">Tags</th>
                <th scope="col" aria-sort="@AriaSort("outcome")">
                    <button type="button" class="btn btn-link p-0 text-decoration-none roster-sort-header" @onclick='() => ToggleSortAsync("outcome")'>
                        Outcome<span class="roster-sort-arrow" aria-hidden="true">@SortArrow("outcome")</span>
                    </button>
                </th>
                <th scope="col" aria-sort="@AriaSort("teamName")">
                    <button type="button" class="btn btn-link p-0 text-decoration-none roster-sort-header" @onclick='() => ToggleSortAsync("teamName")'>
                        Team<span class="roster-sort-arrow" aria-hidden="true">@SortArrow("teamName")</span>
                    </button>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr class="@RowClass(item)"
                    aria-current="@AriaCurrent(item)"
                    tabindex="0"
                    @onclick="() => SelectItemAsync(item)"
                    @onkeydown="args => OnRowKeyDownAsync(args, item)">
                    <td>@(item.TryoutNumber?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                    <td>@item.DisplayName</td>
                    <td>@item.GraduationYear</td>
                    <td>
                        @if (item.AppliedTags.Count == 0)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            @foreach (var tag in item.AppliedTags)
                            {
                                <span class="badge rounded-pill roster-tag @(tag.IsArchived ? "roster-tag-archived" : null)" style="@CampaignRosterDisplay.BuildTagStyle(tag.TagColor)">@tag.TagName</span>
                            }
                        }
                    </td>
                    <td><span class="badge @CampaignRosterDisplay.OutcomeBadgeClass(item.PlacementOutcome)">@CampaignRosterDisplay.OutcomeLabel(item.PlacementOutcome)</span></td>
                    <td>@(item.Team?.TeamName ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
