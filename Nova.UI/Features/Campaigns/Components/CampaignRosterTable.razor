@using System.Globalization
@using Nova.SharedKernel.Features.Campaigns
@using Nova.SharedKernel.Enums

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover align-middle mb-0">
        <caption class="visually-hidden">Campaign roster participants</caption>
        <thead>
            <tr>
                <th scope="col" aria-sort="@AriaSort("displayName")">
                    <button type="button" class="btn btn-link roster-sort-header" @onclick='() => ToggleSortAsync("displayName")'>
                        <span>Name</span>
                        @if (AriaSort("displayName") != "none") { <svg class="sort-indicator" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="@(AriaSort("displayName") == "descending" ? "transform: rotate(180deg)" : null)"><path d="M12 20V4m-6 6 6-6 6 6" /></svg> }
                    </button>
                </th>
                <th scope="col" aria-sort="@AriaSort("outcome")">
                    <button type="button" class="btn btn-link roster-sort-header" @onclick='() => ToggleSortAsync("outcome")'>
                        <span>Campaign outcome</span>
                        @if (AriaSort("outcome") != "none") { <svg class="sort-indicator" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="@(AriaSort("outcome") == "descending" ? "transform: rotate(180deg)" : null)"><path d="M12 20V4m-6 6 6-6 6 6" /></svg> }
                    </button>
                </th>
                @if (WorkingRows is not null)
                {
                    <th scope="col">Effective placement</th>
                }
                else
                {
                    <th scope="col" aria-sort="@AriaSort("teamName")">
                        <button type="button" class="btn btn-link roster-sort-header" @onclick='() => ToggleSortAsync("teamName")'>
                            <span>Campaign team</span>
                        @if (AriaSort("teamName") != "none") { <svg class="sort-indicator" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="@(AriaSort("teamName") == "descending" ? "transform: rotate(180deg)" : null)"><path d="M12 20V4m-6 6 6-6 6 6" /></svg> }
                        </button>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr class="@RowClass(item)" id="@($"roster-row-{item.PlayerCampaignAssignmentId}")"
                    aria-current="@AriaCurrent(item)" tabindex="0" @onclick="() => SelectItemAsync(item)"
                    @onkeydown="args => OnRowKeyDownAsync(args, item)">
                    <td>
                        <div class="roster-person"><CampaignPersonMarker Name="@item.DisplayName" /><div>
                        <strong class="roster-player-name">@item.DisplayName</strong>
                        <small class="roster-player-meta">Tryout #@(item.TryoutNumber?.ToString("D3", CultureInfo.InvariantCulture) ?? "—") · @item.GraduationYear</small>
                        @if (item.AppliedTags.Count > 0)
                        {
                            <small class="roster-player-tags">
                                @foreach (var tag in item.AppliedTags)
                                {
                                    <span class="@(tag.IsArchived ? "roster-tag-archived" : null)">@tag.TagName@(tag.IsArchived ? " (archived)" : "")</span>
                                }
                            </small>
                        }
                        </div></div>
                    </td>
                    <td>
                        <span class="roster-campaign-outcome">@(WorkingRows is not null && item.PlacementOutcome == PlacementOutcome.Undecided ? "No campaign decision" : CampaignRosterDisplay.OutcomeLabel(item.PlacementOutcome))</span>
                        @if (WorkingRows is not null && item.Team is not null) { <small class="roster-player-meta">@item.Team.TeamName</small> }
                    </td>
                    <td>
                        @if (WorkingRows is not null)
                        {
                            <CampaignEffectivePlacementSummary Item="@WorkingRows.FirstOrDefault(row => row.PlayerCampaignAssignmentId == item.PlayerCampaignAssignmentId)" />
                        }
                        else
                        {
                            @(item.Team?.TeamName ?? "—")
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
