<div class="participant-drawer-backdrop" aria-hidden="true" @onclick="CloseAsync"></div>
<aside class="participant-drawer"
       role="dialog"
       aria-modal="true"
       aria-labelledby="participant-drawer-heading"
       @onkeydown="OnKeyDownAsync">
    <header class="participant-drawer-header d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0" id="participant-drawer-heading">@(RosterItem?.DisplayName ?? "Participant")</h2>
        <button type="button"
                class="btn-close"
                @ref="_closeButton"
                aria-label="Close participant details"
                @onclick="CloseAsync"></button>
    </header>
    <div class="participant-drawer-body">
        <p class="text-muted mb-0">Participant details arrive in #64.</p>
    </div>
</aside>
