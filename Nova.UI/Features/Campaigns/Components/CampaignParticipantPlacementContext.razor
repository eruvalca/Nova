@using Nova.SharedKernel.Features.Campaigns
@using Nova.SharedKernel.Enums
@inherits Nova.UI.Components.NovaComponentBase

<section class="participant-placement-context @(Compact ? "is-compact" : null)" aria-label="Participant placement evidence">
    @if (_loading)
    {
        <p role="status">Loading placement context…</p>
    }
    else if (_error)
    {
        <p role="status">Placement context unavailable.</p>
        <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync">Retry placement context</button>
    }
    else if (Compact)
    {
        <details class="context-provenance">
            <summary><span class="context-label">Campaign:</span> @((_working?.LocalDecision ?? _closed?.Source.Decision) is null ? "No decision" : LocalOutcomeLabel)@if ((_working?.LocalTeam ?? _closed?.Source.Team) is { } localTeam) { <span> · @localTeam.TeamName</span> }<span class="visually-hidden"> · placement details</span></summary>
            @if (_working is not null) { <CampaignEffectivePlacementSummary Item="_working" /> }
            @if ((_working?.LocalDecision ?? _closed?.Source.Decision) is { } recorded)
            {
                <p>Campaign decision by @recorded.ActorDisplayName · @recorded.RecordedAt.ToString("MMM d, yyyy")</p>
            }
        </details>
        @if (_working is not null)
        {
            <p><span class="context-label">Season:</span> @EffectiveOutcomeLabel</p>
        }
    }
    else
    {
        <h3>Campaign outcome</h3>
        <p>@LocalOutcomeLabel
            @if ((_working?.LocalTeam ?? _closed?.Source.Team) is { } team) { <strong> · @team.TeamName</strong> }
        </p>
        @if (_working is not null)
        {
            <h3>Effective season placement</h3>
            <CampaignEffectivePlacementSummary Item="_working" />
        }
        else if (_closed is not null)
        {
            <p class="text-muted small">Campaign record · @_closed.Source.CampaignName<br />
                Recorded by @_closed.Source.Decision.ActorDisplayName on @_closed.Source.Decision.RecordedAt.ToString("MMM d, yyyy")</p>
        }
    }
</section>
