@using Nova.SharedKernel.Enums
@using Nova.SharedKernel.Features.Campaigns

<section class="close-review" aria-labelledby="closeout-region-heading" aria-busy="@Loading">
    @if (Detail.Status == CampaignStatus.Closed)
    {
        <div>
            <h2 class="h5" id="closeout-region-heading">Closed campaign</h2>
            <p>This campaign is closed and read-only.</p>
            <p>Closed @(Detail.ClosedAt?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.CurrentCulture) ?? "on an unknown date") by @(Detail.ClosedByDisplayName ?? "Unknown")</p>
        </div>
    }
    else
    {
        <div>
            <h2 class="h5" id="closeout-region-heading">Readiness review</h2>
            @if (Readiness is not null)
            {
                <p class="close-verdict @(Readiness.IsReady ? "ready" : "blocked")">@(Readiness.IsReady ? "Ready to close" : "Work remains")</p>
                <p>@Readiness.Summary.TotalCount participants · @(Readiness.Summary.TotalCount - Readiness.Summary.UndecidedCount) local outcomes</p>
                <p class="close-counts" aria-label="Whole campaign outcomes">Assigned @Readiness.Summary.AssignedCount · Not selected @Readiness.Summary.NotSelectedCount · Withdrawn @Readiness.Summary.WithdrawnCount · No campaign decision @Readiness.Summary.UndecidedCount</p>
                <p class="mb-0"><strong>@Readiness.NeedsPlacementCount need placement</strong><br /><span class="text-body-secondary">Every participant requires a campaign-local outcome.</span></p>
            }
        </div>
        @if (Readiness is not null)
        {
            <div class="close-blockers">
                <h3 class="h6">Blockers to close (@Readiness.Blockers.Count)</h3>
                @foreach (var blocker in Readiness.Blockers)
                {
                    <div class="close-blocker"><span>@BlockerLabel(blocker)</span><a href="@BuildCloseUrl(State with { Blocker = blocker.Condition, Page = 1, Search = null })">Review players<span class="visually-hidden">: @BlockerLabel(blocker)</span></a></div>
                }
                @if (Readiness.IsReady)
                {
                    <p>All participants have an outcome. Assigned participants have compatible, active teams.</p>
                }
            </div>
        }
    }
    @if (Loading)
    {
        <p role="status">Checking Close readiness…</p>
    }
    else if (Error is not null)
    {
        <div role="alert"><p>@Error</p><button type="button" class="btn btn-outline-secondary" @onclick="RetryAsync">Retry readiness</button></div>
    }
    @if (Detail.Status == CampaignStatus.Closed && Readiness is not null)
    {
        <p aria-label="Final outcome summary">Assigned @Readiness.Summary.AssignedCount · Not selected @Readiness.Summary.NotSelectedCount · Withdrawn @Readiness.Summary.WithdrawnCount</p>
    }
</section>
@if (Detail.Status == CampaignStatus.Active)
{
    <CampaignCloseRoster CampaignId="Detail.CampaignId" Owner="@($"{Owner}:{RefreshGeneration}")" State="State" BuildCloseUrl="BuildCloseUrl" BuildParticipantUrl="BuildParticipantUrl" OnStateChanged="OnStateChanged" OnLifecycleChanged="OnLifecycleChanged" />
}
<CampaignLifecycleActions Owner="@Owner" Evidence="Evidence" RefreshEvidence="RefreshEvidence" />
