@using Microsoft.AspNetCore.Components.Forms

<section class="card shadow-sm border-0">
    <div class="card-body">
        <h2 class="h5 mb-3">@Heading</h2>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">@ErrorMessage</div>
        }

        <EditForm Model="_localModel" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary class="visually-hidden" aria-live="polite" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="edit-season-name" class="form-label">Season name</label>
                    <InputText id="edit-season-name" class="form-control" @bind-Value="_localModel.Name" />
                    <ValidationMessage For="() => _localModel.Name" class="text-danger small" />
                </div>
                <div class="col-md-3">
                    <label for="edit-season-start-date" class="form-label">Season start date</label>
                    <InputDate id="edit-season-start-date" class="form-control" @bind-Value="_localModel.StartDate" />
                    <ValidationMessage For="() => _localModel.StartDate" class="text-danger small" />
                </div>
                <div class="col-md-3">
                    <label for="edit-season-end-date" class="form-label">Season end date <span class="text-muted">(optional)</span></label>
                    <InputDate id="edit-season-end-date" class="form-control" @bind-Value="_localModel.EndDate" />
                    <ValidationMessage For="() => _localModel.EndDate" class="text-danger small" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@IsSubmitting">
                    @if (IsSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @SubmitButtonText
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@IsSubmitting" @onclick="OnCancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</section>
