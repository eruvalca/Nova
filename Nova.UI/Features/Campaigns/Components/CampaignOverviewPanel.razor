@using Nova.Shared.Enums

<section class="card shadow-sm border-0" aria-labelledby="overview-region-heading">
    <div class="card-body">
        <h2 class="h5 mb-3" id="overview-region-heading">Overview</h2>

        @if (_isLoading)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading overview...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
                <span>@_error</span>
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryAsync">Retry</button>
            </div>
        }
        else
        {
            <div class="row g-3 mb-3">
                <div class="col-sm-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Season</div>
                        <div class="fw-semibold">@Detail.SeasonName</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Dates</div>
                        <div class="fw-semibold">@FormatCampaignDates(Detail)</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Enrolled</div>
                        <div class="fw-semibold">@Detail.ParticipantCount participants</div>
                    </div>
                </div>
            </div>

            @if (_readiness is not null)
            {
                <div class="row g-2 mb-3" aria-label="Campaign outcome summary">
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="fs-4 fw-semibold">@_readiness.Summary.AssignedCount</div>
                            <div class="text-muted small">Assigned</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="fs-4 fw-semibold">@_readiness.Summary.NotSelectedCount</div>
                            <div class="text-muted small">Not selected</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="fs-4 fw-semibold">@_readiness.Summary.WithdrawnCount</div>
                            <div class="text-muted small">Withdrawn</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <div class="fs-4 fw-semibold">@_readiness.Summary.UndecidedCount</div>
                            <div class="text-muted small">Undecided</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <span class="@(_readiness.IsReady ? "text-success" : "text-warning")" role="status">
                        @(_readiness.IsReady ? "Ready to close" : "Closeout blocked")
                    </span>
                    @if (IsClubAdmin && Detail.Status == CampaignStatus.Active)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="OnOpenCloseout">Open closeout</button>
                    }
                </div>
            }

            <h3 class="h6 mb-2">Activity</h3>
            @if (_activity is null || _activity.Events.Count == 0)
            {
                <p class="text-muted mb-0">No recent activity.</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var item in _activity.Events)
                    {
                        <li class="py-1 border-bottom">@FormatActivityDate(item.CreatedAt) @item.ActorDisplayName @ActivityVerb(item.EventType)</li>
                    }
                </ul>
            }
        }
    </div>
</section>
