@page "/players/{PlayerId:long}"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubMember)]
@using Microsoft.AspNetCore.Authorization
@using Nova.SharedKernel.Enums
@using Nova.SharedKernel.Security
@using Nova.UI.Features.Players.Components
@using Nova.UI.Features.Players.Services

<PageTitle>@(_detail is null ? "Player details" : $"{_detail.FirstName} {_detail.LastName}")</PageTitle>

<div class="container py-4">
    <a class="btn btn-outline-secondary btn-sm mb-3" href="@(_returnUrl ?? "/players")">← Back to roster</a>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
    }

    @if (_isNotFound)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h1 class="h4 mb-2">Player not found</h1>
                <p class="text-muted mb-3">This player does not exist or is not visible to your account.</p>
                <a class="btn btn-outline-secondary btn-sm" href="@(_returnUrl ?? "/players")">Return to roster</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_error</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoadAsync">Retry</button>
        </div>
    }
    else if (_isLoading)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-2">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading player details...</span>
            </div>
        </div>
    }
    else if (_detail is not null)
    {
        <section class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h1 class="h3 mb-1">@_detail.FirstName @_detail.LastName</h1>
                        <p class="text-muted mb-0">
                            Graduation year @_detail.GraduationYear ·
                            <span class="@LifecycleBadgeClass">@_detail.LifecycleStatus</span>
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-sm btn-outline-primary" href="@EditUrl">Edit</a>
                        @if (_canManagePlayers)
                        {
                            @if (_detail.LifecycleStatus == LifecycleStatus.Active)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_isMutating"
                                        @onclick="BeginArchive">
                                    Archive
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" disabled="@_isMutating"
                                        @onclick="RestorePlayerAsync">
                                    Restore
                                </button>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_mutationError))
                {
                    <div class="alert alert-danger" role="alert" aria-live="assertive">@_mutationError</div>
                }

                @if (_detail.LifecycleStatus == LifecycleStatus.Archived)
                {
                    <p class="text-muted small">@PlayerLifecycleCopy.RestoreNote</p>
                }

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted">Date of birth</div>
                        <div>@_detail.DateOfBirth.ToString("MMMM d, yyyy")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted">Gender</div>
                        <div>@(_detail.Gender?.ToString() ?? "Not specified")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-uppercase text-muted">Jersey number</div>
                        <div>@(_detail.JerseyNumber?.ToString() ?? "Not assigned")</div>
                    </div>
                </div>
            </div>
        </section>

        @if (_showArchiveConfirm)
        {
            <div class="mb-3">
                <PlayerLifecycleConfirmation PlayerId="@PlayerId" DisplayName="@(_detail.FirstName + " " + _detail.LastName)"
                                              Blockers="_archiveBlockers" IsBusy="_isMutating"
                                              OnConfirm="ConfirmArchiveAsync" OnCancel="CancelArchive" />
            </div>
        }

        <section class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h2 class="h5">Current tags</h2>
                @if (_detail.CurrentTraits.Count == 0)
                {
                    <p class="text-muted mb-0">No active tags.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var trait in _detail.CurrentTraits)
                        {
                            <span class="badge rounded-pill" style="@BuildTraitStyle(trait)">@trait.Name</span>
                        }
                    </div>
                }
            </div>
        </section>

        <section aria-labelledby="campaign-history-heading">
            <h2 id="campaign-history-heading" class="h5 mb-3">Campaign history</h2>
            @if (_detail.CampaignHistory.Count == 0)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <p class="text-muted mb-0">No campaign history yet.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var history in _detail.CampaignHistory)
                    {
                        <article class="card shadow-sm border-0">
                            <details class="campaign-history-details">
                                <summary class="card-body campaign-history-summary">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <div>
                                            <span class="fw-semibold me-2">@history.CampaignName</span>
                                            <span
                                            class="badge @CampaignStatusBadgeClass(history.CampaignStatus)">@history.CampaignStatus</span>
                                        </div>
                                        <div class="text-muted small">
                                            @history.CampaignStartDate.ToString("MMM d, yyyy")
                                            @if (history.TryoutNumber is not null)
                                            {
                                                <span> · Tryout #@history.TryoutNumber</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="small mt-1">
                                        <span class="text-muted">Outcome: </span><span>@history.PlacementOutcome</span>
                                        @if (history.Team is not null)
                                        {
                                            <span class="text-muted"> · Team: </span><span>@history.Team.Name
                                            (@history.Team.GraduationYear)</span>
                                        }
                                    </div>
                                </summary>

                                <div class="card-body border-top pt-3">
                                    @if (history.TagApplications.Count > 0)
                                    {
                                        <div class="mb-3">
                                            <div class="small fw-semibold text-muted text-uppercase mb-2">Tags</div>
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var tag in history.TagApplications)
                                                {
                                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                                        <span
                                                            class="badge rounded-pill @(tag.IsTagArchived ? "badge-archived" : string.Empty)"
                                                            style="@BuildTagApplicationStyle(tag)">
                                                            @tag.TagName@(tag.IsTagArchived ? " (archived)" : string.Empty)
                                                        </span>
                                                        <span class="small text-muted">
                                                            by @tag.ApplyingUserDisplayName · @tag.AppliedAt.ToString("MMM d, yyyy")
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (history.Notes.Count > 0)
                                    {
                                        <div>
                                            <div class="small fw-semibold text-muted text-uppercase mb-2">Notes</div>
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var note in history.Notes)
                                                {
                                                    <blockquote class="note-entry mb-0">
                                                        <p class="mb-1">@note.Content</p>
                                                        <footer class="small text-muted">
                                                            @note.AuthorDisplayName · @note.CreatedAt.ToString("MMM d, yyyy")
                                                        </footer>
                                                    </blockquote>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (history.TagApplications.Count == 0 && history.Notes.Count == 0)
                                    {
                                        <p class="text-muted mb-0 small">No notes or tags for this campaign.</p>
                                    }
                                </div>
                            </details>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>
