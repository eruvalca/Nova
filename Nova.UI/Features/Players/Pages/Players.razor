@page "/players"
@page "/players/new"
@page "/players/{PlayerId:long}/edit"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubMember)]
@using Microsoft.AspNetCore.Authorization
@using Nova.SharedKernel.Enums
@using Nova.SharedKernel.Security
@using Nova.UI.Features.Players.Components
@*
THESIS: One complete, bounded directory for approved club staff.
OWN-WORLD: Fieldhouse Wayfinding; flat field sheet, teal destinations and semantic controls.
STORY: Choose lifecycle, discover a player, open a record or manual form, return in context.
FIRST VIEWPORT: Counted club destinations and compact discovery above the player rows.
FORM: Native GET discovery and ordinary anchors; twenty rows inside a bounded scroll region.
*@

<PageTitle>Players</PageTitle>

<div class="players-directory">
    @if (CorrectionDestination is { } correction && DraftReturnId is null)
    {
        <a class="btn btn-outline-primary mb-3" href="@correction">Return to placement</a>
    }
    @if (_isClubAdmin && DraftReturnId is { } draftId)
    {
        <a class="btn btn-outline-primary mb-3" href="@DraftCorrectionDestination(draftId)">Return to draft</a>
    }
    <div class="players-heading">
        <h1>Players</h1>
        @if (_canManagePlayers && !IsFormRoute)
        {
            <a class="btn btn-primary" href="@_urlState.ToFormUrl()">Add player</a>
        }
        @if (IsFormRoute)
        {
            <a class="btn btn-outline-primary" href="@BuildCurrentRosterUrl()">Return to players</a>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success" role="status">@_statusMessage</div>
    }
    @if (IsFormRoute)
    {
        @if (_formLoading)
        {
            <p role="status">Loading player…</p>
        }
        @if (_isEditRoute && !_formLoading && _editForm is null && _mutationError is not null)
        {
            <div class="alert alert-danger" role="alert">@_mutationError</div>
            <button class="btn btn-outline-primary" type="button" @onclick="RetryEditAsync">Retry player</button>
        }
    @if (_canManagePlayers && _showCreateForm)
    {
        <div class="mb-3">
            <PlayerForm Heading="Add player" Model="_createForm" IsReadOnly="@(_pendingCreate is not null)" Duplicate="_creationDuplicate" SubmitButtonText="Create player" IsSubmitting="_isMutating"
                        DuplicateDetailUrl="@(_creationDuplicate is { } duplicate ? new Uri(BuildPlayerDetailUrl(duplicate.PlayerId), UriKind.Relative) : null)"
                        ErrorMessage="@_mutationError" GraduationYearBlockers="_graduationYearBlockers"
                        OnValidSubmit="CreatePlayerAsync" OnCancel="CancelMutationForm" />
        </div>
    }

    @if (_canManagePlayers && _editForm is not null)
    {
        <div class="mb-3">
            <PlayerForm Heading="Edit player" Model="_editForm" SubmitButtonText="Save changes" IsSubmitting="_isMutating"
                        ErrorMessage="@_mutationError" GraduationYearBlockers="_graduationYearBlockers"
                        OnValidSubmit="UpdatePlayerAsync" OnCancel="CancelMutationForm" />
        </div>
    }


    }
    else
    {
        <nav class="players-views" aria-label="Player lifecycle">
            <a href="@((_urlState with { View = "active", Page = 1 }).ToDirectoryUrl())"
               aria-current="@(_urlState.View == "active" ? "page" : null)">Active <span>@(_summary?.ActiveCount.ToString() ?? "—")</span></a>
            <a href="@((_urlState with { View = "archived", Page = 1 }).ToDirectoryUrl())"
               aria-current="@(_urlState.View == "archived" ? "page" : null)">Archived <span>@(_summary?.ArchivedCount.ToString() ?? "—")</span></a>
            <span class="players-count-label">@ClubCountLabel</span>
        </nav>
        @if (_summaryError is not null)
        {
            <div class="players-regional-error" role="alert">
                <span>Club totals and graduation years unavailable. @_summaryError</span>
                <button class="btn btn-outline-primary" type="button" disabled="@_summaryLoading" @onclick="LoadSummaryAsync">Retry club totals</button>
            </div>
        }
        <form class="players-discovery" method="get" action="/players" @onsubmit="ApplyDiscovery" @onsubmit:preventDefault>
            <input type="hidden" name="view" value="@_urlState.View" />
            @if (DraftReturnId is { } returnDraft)
            {
                <input type="hidden" name="returnToDraft" value="@returnDraft" />
            }
            @if (CorrectionDestination is { } returnDestination)
            {
                <input type="hidden" name="returnUrl" value="@returnDestination" />
            }
            <div class="players-search">
                <label for="players-search" class="form-label">Search name or tryout number</label>
                <input id="players-search" name="search" class="form-control" type="search" value="@_searchDraft"
                       aria-invalid="@(SearchError is not null ? "true" : null)" aria-describedby="@(SearchError is not null ? "players-search-error" : null)"
                       @oninput="OnSearchInputChangedAsync" placeholder="e.g. Avery, 12" />
            </div>
            <div>
                <label for="players-grad-year" class="form-label">Graduation year</label>
                <select id="players-grad-year" name="graduationYear" class="form-select" value="@GraduationYearFilterText" @onchange="OnGraduationYearChanged">
                    <option value="">All years</option>
                    @if (_urlState.GraduationYear is { } savedYear && !AvailableGraduationYears.Contains(savedYear))
                    {
                        <option value="@savedYear">@savedYear</option>
                    }
                    @foreach (var year in AvailableGraduationYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div>
                <label for="players-tag-filter" class="form-label">Tag</label>
                <select id="players-tag-filter" name="tag" class="form-select" value="@PlayerTagFilterText" @onchange="OnTagFilterChanged">
                    <option value="">@(_tagsLoading ? "Loading tags…" : "All tags")</option>
                    @if (HasSavedTag)
                    {
                        <option value="@PlayerTagFilterText">Saved tag filter</option>
                    }
                    @foreach (var tag in _availableTags)
                    {
                        <option value="@tag.PlayerTagId">@tag.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Apply</button>
        </form>
        @if (SearchError is { } searchError)
        {
            <p id="players-search-error" class="text-danger" role="alert">@searchError</p>
        }
        @if (_tagsError is not null)
        {
            <div class="players-regional-error" role="alert">
                <span>Tag choices unavailable. @_tagsError</span>
                <button class="btn btn-outline-primary" type="button" disabled="@_tagsLoading" @onclick="LoadTagsAsync">Retry tag choices</button>
            </div>
        }
        @if (HasSavedTag)
        {
            <p class="players-saved-filter">Saved tag filter is applied.
                <a href="@((_urlState with { TagId = null, Page = 1 }).ToDirectoryUrl())">Remove saved tag filter</a>
            </p>
        }
        <div class="players-result-summary" aria-live="polite">
            <span>@ResultSummary</span>
            @if (_urlState.HasFilters)
            {
                <a href="@((_urlState with { Search = string.Empty, GraduationYear = null, TagId = null, Page = 1 }).ToDirectoryUrl())">Clear filters</a>
            }
        </div>
        @if (_pageError is not null)
        {
            <div class="alert alert-danger" role="alert">
                <span>@_pageError</span>
                <button class="btn btn-outline-danger" type="button" @onclick="ReloadAsync">Retry players</button>
            </div>
        }
        @if (_mutationError is not null)
        {
            <div class="alert alert-danger" role="alert">@_mutationError</div>
        }
    @if (_canManagePlayers && _archiveCandidate is not null)
    {
        <section class="players-confirmation mb-3" aria-live="polite">
            <div class="p-3">
                <h2 class="h5">Archive @(_archiveCandidate.DisplayName)?</h2>
                <p class="text-muted">
                    Archiving preserves campaign history. Any unresolved active-campaign blockers must be resolved first.
                </p>
                @if (_archiveBlockers.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <div class="fw-semibold mb-2">Archive blockers:</div>
                        <ul class="mb-0">
                            @foreach (var blocker in _archiveBlockers)
                            {
                                <li>
                                    @blocker.CampaignName (Campaign @blocker.CampaignId): participation IDs @string.Join(", ",
                                    blocker.ParticipationIds)
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-check mb-3">
                    <input id="archive-confirm-checkbox" class="form-check-input" type="checkbox"
                           @bind="_archiveConfirmed" />
                    <label class="form-check-label" for="archive-confirm-checkbox">
                        I understand this player will be moved to the archived roster.
                    </label>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-warning" disabled="@(!_archiveConfirmed || _isMutating)"
                            @onclick="ConfirmArchiveAsync">Archive player</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelArchive">Cancel</button>
                </div>
            </div>
        </section>
    }


        @if (!_isLoading && _roster?.Items.Count is 0)
        {
            <section class="players-empty" aria-labelledby="players-empty-title">
                <h2 id="players-empty-title" class="h5">@EmptyHeading</h2>
                <p>@EmptyDescription</p>
                @if (_urlState.Page > 1)
                {
                    <a class="btn btn-outline-primary" href="@((_urlState with { Page = 1 }).ToDirectoryUrl())">Go to first page</a>
                }
                else if (!_urlState.HasFilters && _urlState.View == "active" && _summary?.ArchivedCount > 0)
                {
                    <a class="btn btn-outline-primary" href="@((_urlState with { View = "archived" }).ToDirectoryUrl())">View archived players</a>
                }
            </section>
        }
        else if (!_isLoading && _roster is not null)
        {
            <div class="players-table-region" role="region" aria-label="Player directory" tabindex="0">
                <table class="table align-middle mb-0 players-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Graduation year</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Active campaigns</th>
                            @if (_canManagePlayers)
                            {
                                <th scope="col" class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody @key="_urlState.QueryFingerprint">
                        @foreach (var player in _roster.Items)
                        {
                            <tr>
                                <td>
                                    <a class="player-record-link" href="@BuildPlayerDetailUrl(player.PlayerId)">@player.DisplayName</a>
                                </td>
                                <td>@player.GraduationYear</td>
                                <td>
                                    @if (player.CurrentTags.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var tag in player.CurrentTags)
                                            {
                                                <span class="badge rounded-pill tag-pill" style="@BuildTagStyle(tag)">@tag.Name</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (player.ActiveCampaigns.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", player.ActiveCampaigns)
                                    }
                                </td>
                                @if (_canManagePlayers)
                                {
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-2">
                                            <a class="btn btn-sm btn-outline-primary" href="@_urlState.ToFormUrl(player.PlayerId)">Edit</a>
                                            @if (player.LifecycleStatus == LifecycleStatus.Active)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning"
                                                        disabled="@_isMutating" @onclick="() => BeginArchive(player)">
                                                    Archive
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-success"
                                                        disabled="@_isMutating" @onclick="() => RestorePlayerAsync(player)">
                                                    Restore
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (!_isLoading && _roster is not null && _roster.Items.Count > 0)
        {
            <nav class="players-paging" aria-label="Directory pages">
                @if (_urlState.Page > 1)
                {
                    <a class="btn btn-outline-primary" rel="prev" href="@((_urlState with { Page = _urlState.Page - 1 }).ToDirectoryUrl())">Previous</a>
                }
                else
                {
                    <span class="btn btn-outline-secondary disabled" aria-disabled="true">Previous</span>
                }
                <span>Page @_urlState.Page of @PageCount</span>
                @if (_urlState.Page < PageCount)
                {
                    <a class="btn btn-outline-primary" rel="next" href="@((_urlState with { Page = _urlState.Page + 1 }).ToDirectoryUrl())">Next</a>
                }
                else
                {
                    <span class="btn btn-outline-secondary disabled" aria-disabled="true">Next</span>
                }
            </nav>
        }
        <p class="players-lifecycle-note">Restoring reactivates the profile only; campaigns missed while archived are not backfilled automatically.</p>
    }
</div>
