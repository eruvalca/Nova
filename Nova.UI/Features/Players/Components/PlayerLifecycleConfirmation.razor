@using Microsoft.AspNetCore.Components
@using Nova.UI.Features.Players.Services
@namespace Nova.UI.Features.Players.Components
@*
THESIS: One archive confirmation, shared by the directory and Player detail.
OWN-WORLD: Fieldhouse Wayfinding; flat board, Roster Hairline, Copper for destructive attention.
STORY: Read what archiving preserves, acknowledge the consequence, then commit or cancel.
FIRST VIEWPORT: The player's name, the consequence sentence, and any blocking campaigns.
FORM: A bounded inline confirmation beside the action that opened it.
*@

<section class="lifecycle-confirmation" id="archive-confirmation" aria-labelledby="archive-confirmation-heading">
    <h3 class="h5" id="archive-confirmation-heading" tabindex="-1" autofocus>@PlayerLifecycleCopy.ArchiveHeading(DisplayName)</h3>
    <p class="lifecycle-consequence">@PlayerLifecycleCopy.ArchiveConsequence</p>

    @if (Blockers.Count > 0)
    {
        <div class="lifecycle-attention" role="alert" id="archive-blockers">
            <div class="fw-semibold mb-2">@PlayerLifecycleCopy.BlockersHeading</div>
            <ul class="mb-0">
                @foreach (var blocker in Blockers)
                {
                    <li>@PlayerLifecycleCopy.BlockerText(blocker)</li>
                }
            </ul>
        </div>
    }

    <div class="form-check mb-3">
        <input id="archive-confirm-checkbox" class="form-check-input" type="checkbox" @bind="_acknowledged" />
        <label class="form-check-label" for="archive-confirm-checkbox">@PlayerLifecycleCopy.ArchiveAcknowledge</label>
    </div>

    <div class="lifecycle-actions">
        <button type="button" class="btn btn-warning" id="archive-commit" disabled="@(!_acknowledged || IsBusy)" @onclick="ConfirmAsync">
            @PlayerLifecycleCopy.ArchiveCommit
        </button>
        <button type="button" class="btn btn-outline-secondary" id="archive-cancel" disabled="@IsBusy" @onclick="OnCancel">Cancel</button>
    </div>
</section>
