@using Microsoft.AspNetCore.Components.Forms
@using Nova.UI.Shared

<EditForm Model="_input" OnValidSubmit="HandleSubmitAsync">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (_crestErrors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <ul class="mb-0 list-unstyled">
                @foreach (var error in _crestErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="mb-3">
        <label for="club-name" class="form-label">Club Name</label>
        <InputText id="club-name" class="form-control" @bind-value="_input.Name" placeholder="e.g. Eastside FC" />
        <ValidationMessage For="() => _input.Name" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label for="club-city" class="form-label">City</label>
        <InputText id="club-city" class="form-control" @bind-value="_input.City" placeholder="e.g. Austin" />
        <ValidationMessage For="() => _input.City" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label for="club-state" class="form-label">State</label>
        <InputText id="club-state" class="form-control" @bind-value="_input.State" placeholder="e.g. TX" />
        <ValidationMessage For="() => _input.State" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label for="club-crest" class="form-label">Club Crest</label>
        @if (IsCropping)
        {
            <div class="club-crest-cropper-frame mb-2">
                <NovaCropperComponent @ref="_cropper" Class="club-crest-cropper" Src="@_crestPreviewUrl"
                                      Options="_cropperOptions" OnReady="OnCropperReady" />
            </div>
        }
        else if (_crestPreviewUrl is not null)
        {
            <div class="mb-2 text-center">
                <img src="@_crestPreviewUrl" alt="Club crest preview" class="club-crest-preview" />
                <p class="text-muted mt-2">Your club crest will appear in the navigation menu and on the club page.</p>
            </div>
        }

        @if (IsCropping)
        {
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button type="button" class="btn btn-primary" disabled="@(_submitting || !CanSubmit)" @onclick="SaveCrestAsync">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    }
                    Save crest
                </button>
                <button type="button" class="btn btn-outline-secondary" disabled="@_submitting" @onclick="ClearSelection">
                    Choose a different image
                </button>
            </div>
            <p class="text-muted">Adjust the crop box or keep the whole image, then click <strong>Save crest</strong>.</p>
        }
        else
        {
            <InputFile id="club-crest" class="form-control" accept="@AcceptTypes" OnChange="OnCrestSelectedAsync"
                       disabled="@_submitting" />
            <div class="form-text">JPEG, PNG, or WebP. Maximum size 10 MB.</div>
        }
    </div>

    <button type="submit" class="btn btn-primary" disabled="@(_submitting || IsCropping)">
        @if (_submitting)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        }
        Create Club
    </button>
</EditForm>
