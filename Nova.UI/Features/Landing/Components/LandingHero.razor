@* Hero — the approved headline with administrator-first supporting copy and the primary/secondary actions. *@
<section class="hero py-5 bg-success-subtle border-bottom border-success-subtle" aria-labelledby="hero-heading">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3" id="hero-heading">Run better tryouts. Build stronger teams.</h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 40rem;">
            Nova gives club administrators one place to run tryouts from roster to result: enroll
            players, invite coaches and evaluators, record evaluations, and place players onto teams —
            with every club's data kept isolated and role-based access enforced.
        </p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
            <a class="btn btn-primary btn-lg" href="@CreateClubUrl">Create your club</a>
            <a class="btn btn-outline-dark btn-lg" href="#how-it-works">See how it works</a>
        </div>
    </div>
</section>
