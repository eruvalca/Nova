@* Product preview — an illustrative, non-interactive view of a real Nova tryout campaign
   progressing from roster management through evaluation to team placement. Illustrative only. *@
<section class="product-preview py-5" id="product" aria-labelledby="product-heading">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="h1 fw-bold mb-2" id="product-heading">One campaign, from roster to team placement</h2>
            <p class="text-muted mx-auto" style="max-width: 42rem;">
                A preview of a real Nova tryout campaign. Sample content is illustrative — your club's
                players, evaluations, and placements live in your own isolated workspace.
            </p>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-primary-subtle bg-primary-subtle preview-step" aria-labelledby="preview-roster-heading">
                    <div class="card-body">
                        <span class="badge text-bg-primary mb-3">Step 1</span>
                        <h3 class="h5 fw-semibold mb-2" id="preview-roster-heading">Build the roster</h3>
                        <p class="text-muted small mb-3">
                            Enroll the players invited to your club's tryout and organize them for evaluation.
                        </p>
                        <ul class="list-unstyled small mb-0">
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span>Avery Chen</span><span class="text-muted">Forward</span>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span>Jordan Rivera</span><span class="text-muted">Midfielder</span>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span>Skyler Brooks</span><span class="text-muted">Defender</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-info-subtle bg-info-subtle preview-step" aria-labelledby="preview-evaluation-heading">
                    <div class="card-body">
                        <span class="badge text-bg-info mb-3">Step 2</span>
                        <h3 class="h5 fw-semibold mb-2" id="preview-evaluation-heading">Collaborate on evaluations</h3>
                        <p class="text-muted small mb-3">
                            Coaches and evaluators record notes and apply tags within their own role-based
                            permissions.
                        </p>
                        <div class="small">
                            <div class="d-flex justify-content-between border-bottom py-1">
                                <span>Avery Chen</span><span class="text-success">Tagged</span>
                            </div>
                            <div class="border-bottom py-1">
                                <span class="text-muted d-block">Coach note</span>
                                <span>Strong first touch; quick to read space.</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span>Jordan Rivera</span><span class="text-warning">Unresolved</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-success-subtle bg-success-subtle preview-step" aria-labelledby="preview-placement-heading">
                    <div class="card-body">
                        <span class="badge text-bg-success mb-3">Step 3</span>
                        <h3 class="h5 fw-semibold mb-2" id="preview-placement-heading">Place players onto teams</h3>
                        <p class="text-muted small mb-3">
                            Resolve placements and close out the campaign so your club can act on the
                            results.
                        </p>
                        <ul class="list-unstyled small mb-0">
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span>Avery Chen</span><span class="text-muted">U14 Blue</span>
                            </li>
                            <li class="d-flex justify-content-between py-1 border-bottom">
                                <span>Skyler Brooks</span><span class="text-muted">U14 White</span>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span>Jordan Rivera</span><span class="text-muted">Pending</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
