@* Trust — limited to verifiable behavior: role-based access and club data isolation. *@
<section class="trust py-5" aria-labelledby="trust-heading">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="h1 fw-bold mb-2" id="trust-heading">Trusted by design</h2>
            <p class="text-muted mx-auto" style="max-width: 42rem;">
                The safeguards Nova enforces are the ones you can verify in the product itself.
            </p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-5">
                <div class="text-center bg-light rounded p-4 h-100">
                    <span class="bi bi-shield-check display-6 text-primary" aria-hidden="true"></span>
                    <h3 class="h5 mt-3 mb-2 fw-semibold">Role-based access</h3>
                    <p class="text-muted small mb-0">
                        Administrators, coaches, and evaluators work within permissions enforced by their
                        role.
                    </p>
                </div>
            </div>
            <div class="col-md-5">
                <div class="text-center bg-light rounded p-4 h-100">
                    <span class="bi bi-diagram-3 display-6 text-info" aria-hidden="true"></span>
                    <h3 class="h5 mt-3 mb-2 fw-semibold">Club data isolation</h3>
                    <p class="text-muted small mb-0">
                        Every club's players, campaigns, and evaluations stay scoped to that club's own
                        workspace.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
