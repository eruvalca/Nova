@* How it works — a short anchored sequence using Nova's own terminology. *@
<section class="how-it-works py-5" id="how-it-works" aria-labelledby="how-it-works-heading">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="h1 fw-bold mb-2" id="how-it-works-heading">How it works</h2>
            <p class="text-muted mx-auto" style="max-width: 42rem;">
                Nova uses the workflow your coaching staff already runs — organized and kept in one place.
            </p>
        </div>

        <ol class="list-unstyled row g-4 mb-0">
            <li class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-primary-subtle bg-primary-subtle">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="landing-step-number text-bg-primary me-3">1</span>
                            <h3 class="h5 mb-0 fw-semibold">Establish the context</h3>
                        </div>
                        <p class="text-muted small mb-0">
                            Create your club, add a campaign, and enroll the players invited to your
                            tryouts.
                        </p>
                    </div>
                </div>
            </li>
            <li class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-info-subtle bg-info-subtle">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="landing-step-number text-bg-info me-3">2</span>
                            <h3 class="h5 mb-0 fw-semibold">Collaborate on evaluations</h3>
                        </div>
                        <p class="text-muted small mb-0">
                            Invite coaches and evaluators, record notes, and apply tags within role-based
                            permissions.
                        </p>
                    </div>
                </div>
            </li>
            <li class="col-md-4">
                <div class="card h-100 shadow-sm border-0 border-top border-success-subtle bg-success-subtle">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <span class="landing-step-number text-bg-success me-3">3</span>
                            <h3 class="h5 mb-0 fw-semibold">Resolve placements &amp; close out</h3>
                        </div>
                        <p class="text-muted small mb-0">
                            Place players onto teams, close the campaign, and move forward with a clear
                            roster.
                        </p>
                    </div>
                </div>
            </li>
        </ol>
    </div>
</section>
