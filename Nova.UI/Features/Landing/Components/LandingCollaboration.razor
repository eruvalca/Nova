@* Admin/coach collaboration — role fit without implying separate products. *@
<section class="collaboration py-5" id="collaboration" aria-labelledby="collaboration-heading">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <h2 class="h1 fw-bold mb-3" id="collaboration-heading">Built for the whole coaching staff</h2>
                <p class="text-muted mb-4">
                    Nova brings administrators and coaches together in one club workspace, with every
                    role seeing just what it needs.
                </p>
                <ul class="list-unstyled mb-0">
                    <li class="d-flex gap-3 mb-3">
                        <span class="bi bi-gear text-primary flex-shrink-0" aria-hidden="true"></span>
                        <div>
                            <span class="fw-semibold d-block">Club administrators organize and govern</span>
                            <span class="text-muted small">Set up the club and campaigns, manage the roster, and decide final team placements.</span>
                        </div>
                    </li>
                    <li class="d-flex gap-3 mb-3">
                        <span class="bi bi-clipboard-check text-info flex-shrink-0" aria-hidden="true"></span>
                        <div>
                            <span class="fw-semibold d-block">Coaches and evaluators contribute</span>
                            <span class="text-muted small">Record evaluations, apply tags, and collaborate within their role-based permissions.</span>
                        </div>
                    </li>
                    <li class="d-flex gap-3">
                        <span class="bi bi-shield-lock text-success flex-shrink-0" aria-hidden="true"></span>
                        <div>
                            <span class="fw-semibold d-block">Access stays role-based</span>
                            <span class="text-muted small">Permissions are enforced per role, so each person stays focused on their own work.</span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h3 class="h6 text-muted text-uppercase mb-3">One workspace, two roles</h3>
                        <div class="row g-3 mb-0">
                            <div class="col-6">
                                <div class="border border-primary-subtle bg-primary-subtle rounded p-3 h-100">
                                    <span class="badge text-bg-primary mb-2">Admin</span>
                                    <p class="small text-muted mb-0">Organizes the club, governs the campaign, and approves the final roster.</p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="border border-info-subtle bg-info-subtle rounded p-3 h-100">
                                    <span class="badge text-bg-info mb-2">Coach</span>
                                    <p class="small text-muted mb-0">Evaluates players and contributes notes and tags within their permissions.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
