@page "/teams"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireEvaluator)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Enums
@using Nova.Shared.Security
@using Nova.UI.Features.Teams.Components

<PageTitle>Teams</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <h1 class="mb-0">Teams</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <label for="teams-view-filter" class="visually-hidden">Roster view</label>
            <select id="teams-view-filter" class="form-select teams-view-select" value="@_lifecycleStatusFilter" @onchange="OnLifecycleStatusChangedAsync">
                <option value="active">Active</option>
                <option value="archived">Archived</option>
            </select>
            @if (_canManageTeams)
            {
                <button type="button" class="btn btn-primary" disabled="@_isMutating" @onclick="ShowCreateForm">
                    Add team
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ReloadAsync">Retry</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_actionError))
    {
        <div class="alert alert-danger" role="alert" aria-live="assertive">@_actionError</div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <label for="teams-search" class="form-label">Search team name</label>
                    <input id="teams-search"
                           class="form-control"
                           type="search"
                           maxlength="200"
                           value="@_searchDraft"
                           @oninput="OnSearchInputChangedAsync"
                           placeholder="e.g. U16 Blue" />
                </div>
                <div class="col-md-4">
                    <label for="teams-grad-year" class="form-label">Graduation year</label>
                    <select id="teams-grad-year" class="form-select" value="@GraduationYearFilterText" @onchange="OnGraduationYearChangedAsync">
                        <option value="">All years</option>
                        @foreach (var year in _availableGraduationYears)
                        {
                            <option value="@year.ToString()">@year</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_showCreateForm)
    {
        <div class="mb-3">
            <TeamForm Heading="Add team"
                      Model="_createForm"
                      SubmitButtonText="Create team"
                      IsSubmitting="_isMutating"
                      ErrorMessage="_formError"
                      CutoffBlockers="_cutoffBlockers"
                      OnValidSubmit="CreateTeamAsync"
                      OnCancel="CancelMutationForm" />
        </div>
    }

    @if (_editForm is not null)
    {
        <div class="mb-3">
            <TeamForm Heading="Edit team"
                      Model="_editForm"
                      SubmitButtonText="Save changes"
                      IsSubmitting="_isMutating"
                      ErrorMessage="_formError"
                      CutoffBlockers="_cutoffBlockers"
                      OnValidSubmit="UpdateTeamAsync"
                      OnCancel="CancelMutationForm" />
        </div>
    }

    @if (_archiveCandidate is not null)
    {
        <section class="card shadow-sm border-0 mb-3" aria-live="polite">
            <div class="card-body">
                <h2 class="h5">Archive @(_archiveCandidate.Name)?</h2>
                <p class="text-muted">
                    Archiving preserves campaign history. Resolve active placement blockers before continuing.
                </p>
                @if (_archiveBlockers.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <div class="fw-semibold mb-2">Archive blockers:</div>
                        <ul class="mb-0">
                            @foreach (var blocker in _archiveBlockers)
                            {
                                <li>
                                    @blocker.CampaignName (Campaign @blocker.CampaignId): placement IDs @string.Join(", ", blocker.PlacementIds)
                                </li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-check mb-3">
                    <input id="archive-confirm-checkbox" class="form-check-input" type="checkbox" disabled="@_isMutating" @bind="_archiveConfirmed" />
                    <label class="form-check-label" for="archive-confirm-checkbox">
                        I understand this team will be moved to the archived roster.
                    </label>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-warning" disabled="@(!_archiveConfirmed || _isMutating)" @onclick="ConfirmArchiveAsync">Archive team</button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isMutating" @onclick="CancelArchive">Cancel</button>
                </div>
            </div>
        </section>
    }

    @if (_isLoading)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-2" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading teams...</span>
            </div>
        </div>
    }
    else if (_roster?.Count is 0)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h5 mb-2">No teams found</h2>
                <p class="text-muted mb-0">Try changing filters or add a new team.</p>
            </div>
        </div>
    }
    else if (_roster is not null)
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Team</th>
                            <th scope="col">Graduation year</th>
                            <th scope="col">Active placements</th>
                            @if (_canManageTeams)
                            {
                                <th scope="col" class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var team in _roster)
                        {
                            <tr>
                                <td>@team.Name</td>
                                <td>@team.GraduationYear</td>
                                <td>@team.ActivePlacementCount</td>
                                @if (_canManageTeams)
                                {
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-2">
                                            @if (team.LifecycleStatus == LifecycleStatus.Active)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        aria-label="@($"Edit {team.Name}")"
                                                        disabled="@_isMutating"
                                                        @onclick="() => BeginEdit(team)">
                                                    Edit
                                                </button>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning"
                                                        aria-label="@($"Archive {team.Name}")"
                                                        disabled="@_isMutating"
                                                        @onclick="() => BeginArchive(team)">
                                                    Archive
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-success"
                                                        aria-label="@($"Restore {team.Name}")"
                                                        disabled="@_isMutating"
                                                        @onclick="() => RestoreTeamAsync(team)">
                                                    Restore
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
