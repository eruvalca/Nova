@page "/teams/{TeamId:long}"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireEvaluator)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Enums
@using Nova.Shared.Security
@using Nova.Shared.Teams
@using Nova.UI.Features.Teams.Components

<PageTitle>@(_detail is null ? "Team details" : _detail.Name)</PageTitle>

<div class="container py-4">
    <a class="btn btn-outline-secondary btn-sm mb-3" href="@(_returnUrl ?? "/teams")">← Back to teams</a>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
    }

    @if (_isNotFound)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <h1 class="h4 mb-2">Team not found</h1>
                <p class="text-muted mb-3">This team does not exist or is not visible to your account.</p>
                <a class="btn btn-outline-secondary btn-sm" href="@(_returnUrl ?? "/teams")">Return to teams</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_error</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryLoadAsync">Retry</button>
        </div>
    }
    else if (_isLoading)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-2" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Loading team details...</span>
            </div>
        </div>
    }
    else if (_detail is not null)
    {
        <section class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h1 class="h3 mb-1">@_detail.Name</h1>
                        <p class="text-muted mb-0">
                            Graduation year @_detail.GraduationYear ·
                            <span class="@LifecycleBadgeClass">@_detail.LifecycleStatus</span>
                        </p>
                    </div>
                    @if (_canManageTeams)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @if (_detail.LifecycleStatus == LifecycleStatus.Active)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_isMutating" @onclick="BeginEdit">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_isMutating" @onclick="BeginArchive">
                                    Archive
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" disabled="@_isMutating" @onclick="RestoreTeamAsync">
                                    Restore
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_mutationError))
                {
                    <div class="alert alert-danger" role="alert" aria-live="assertive">@_mutationError</div>
                }
            </div>
        </section>

        @if (_showEditForm && _editForm is not null)
        {
            <div class="mb-3">
                <TeamForm Heading="Edit team"
                          Model="_editForm"
                          SubmitButtonText="Save changes"
                          IsSubmitting="_isMutating"
                          ErrorMessage="_formError"
                          CutoffBlockers="_cutoffBlockers"
                          OnValidSubmit="UpdateTeamAsync"
                          OnCancel="CancelEdit" />
            </div>
        }

        @if (_showArchiveConfirm)
        {
            <section class="card shadow-sm border-0 mb-3" aria-live="polite">
                <div class="card-body">
                    <h2 class="h5">Archive @_detail.Name?</h2>
                    <p class="text-muted">
                        Archiving preserves campaign history. Resolve active placement blockers before continuing.
                    </p>
                    @if (_archiveBlockers.Count > 0)
                    {
                        <div class="alert alert-warning" role="alert">
                            <div class="fw-semibold mb-2">Archive blockers:</div>
                            <ul class="mb-0">
                                @foreach (var blocker in _archiveBlockers)
                                {
                                    <li>
                                        @blocker.CampaignName (Campaign @blocker.CampaignId): placement IDs @string.Join(", ", blocker.PlacementIds)
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="form-check mb-3">
                        <input id="archive-confirm-checkbox" class="form-check-input" type="checkbox" disabled="@_isMutating" @bind="_archiveConfirmed" />
                        <label class="form-check-label" for="archive-confirm-checkbox">
                            I understand this team will be moved to the archived roster.
                        </label>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-warning" disabled="@(!_archiveConfirmed || _isMutating)" @onclick="ConfirmArchiveAsync">Archive team</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@_isMutating" @onclick="CancelArchive">Cancel</button>
                    </div>
                </div>
            </section>
        }

        @if (_detail.ActivePlacementImpacts.Count > 0)
        {
            <section class="card shadow-sm border-0 mb-3" aria-labelledby="active-impact-heading">
                <div class="card-body">
                    <h2 id="active-impact-heading" class="h5 mb-3">
                        Active campaign placements
                        @if (_detail.ActivePlacementImpactTotalCount > _detail.ActivePlacementImpacts.Count)
                        {
                            <span class="text-muted small ms-2">(@_detail.ActivePlacementImpacts.Count of @_detail.ActivePlacementImpactTotalCount shown)</span>
                        }
                    </h2>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Player</th>
                                    <th scope="col">Grad year</th>
                                    <th scope="col">Campaign</th>
                                    <th scope="col">Tryout #</th>
                                    <th scope="col">Outcome</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var impact in _detail.ActivePlacementImpacts)
                                {
                                    <tr>
                                        <td>@impact.PlayerDisplayName</td>
                                        <td>@impact.PlayerGraduationYear</td>
                                        <td>@impact.CampaignName</td>
                                        <td>@(impact.TryoutNumber?.ToString() ?? "—")</td>
                                        <td>@impact.PlacementOutcome</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

        <section aria-labelledby="placement-history-heading">
            <h2 id="placement-history-heading" class="h5 mb-3">
                Placement history
                @if (_detail.IsPlacementHistoryTruncated)
                {
                    <span class="text-muted small ms-2">(@_detail.PlacementHistory.Count of @_detail.PlacementHistoryTotalCount shown)</span>
                }
            </h2>
            @if (_detail.PlacementHistory.Count == 0)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <p class="text-muted mb-0">No placement history yet.</p>
                    </div>
                </div>
            }
            else
            {
                var campaignGroups = GroupPlacementsByCampaign(_detail.PlacementHistory);
                <div class="d-flex flex-column gap-3">
                    @foreach (var group in campaignGroups)
                    {
                        <article class="card shadow-sm border-0">
                            <details class="placement-history-details">
                                <summary class="card-body placement-history-summary">
                                    <span class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span>
                                            <span class="fw-semibold me-2">@group.CampaignName</span>
                                            <span class="badge @CampaignStatusBadgeClass(group.CampaignStatus)">@group.CampaignStatus</span>
                                        </span>
                                        <span class="text-muted small">
                                            @group.CampaignStartDate.ToString("MMM d, yyyy") ·
                                            @group.Placements.Count player@(group.Placements.Count != 1 ? "s" : string.Empty)
                                        </span>
                                    </span>
                                </summary>
                                <div class="card-body border-top pt-3">
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col">Player</th>
                                                    <th scope="col">Grad year</th>
                                                    <th scope="col">Tryout #</th>
                                                    <th scope="col">Outcome</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in group.Placements)
                                                {
                                                    <tr>
                                                        <td>@item.PlayerDisplayName</td>
                                                        <td>@item.PlayerGraduationYear</td>
                                                        <td>@(item.TryoutNumber?.ToString() ?? "—")</td>
                                                        <td>@item.PlacementOutcome</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </details>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>
