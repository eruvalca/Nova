@using Cropper.Blazor.Components
@using Microsoft.AspNetCore.Components.Forms
@using Nova.UI.Shared

<!--
THESIS: The photo editor turns image selection and framing into one legible two-stop route.
OWN-WORLD: Connected route markers, a circular portrait field, flat hairline boards, and explicit action states.
STORY: The member chooses a supported image, reviews or frames it, then saves or safely leaves the flow.
FIRST VIEWPORT: The two-stop route and current portrait state make the next action unmistakable.
FORM: Shared interactive editor; selection and crop states occupy one bounded workspace without changing service contracts.
-->

<div class="profile-photo-editor">
    <ol class="photo-route" aria-label="Profile photo steps">
        <li class="photo-route-stop @(ImageDataUrl is null ? "is-active" : "is-complete")"
            aria-current="@(ImageDataUrl is null ? "step" : null)">
            <span class="photo-route-marker" aria-hidden="true">1</span>
            <span>Choose image</span>
        </li>
        <li class="photo-route-stop @(ImageDataUrl is null ? null : "is-active")"
            aria-current="@(ImageDataUrl is null ? null : "step")">
            <span class="photo-route-marker" aria-hidden="true">2</span>
            <span>Frame and save</span>
        </li>
    </ol>

    @if (_errorMessages.Count > 0)
    {
        <div class="alert alert-danger photo-editor-errors" role="alert" aria-live="assertive">
            <ul class="mb-0 list-unstyled">
                @foreach (var error in _errorMessages)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (ImageDataUrl is null)
    {
        @if (ExistingPhotoUrl is not null)
        {
            <figure class="profile-photo-preview">
                <img src="@ExistingPhotoUrl" alt="Your current profile photo" class="profile-photo-current rounded-circle" />
                <figcaption>Your current profile photo. Choose a new image to replace it.</figcaption>
            </figure>
        }

        <div class="photo-selection">
            <label for="profile-photo-input" class="form-label">Choose a photo</label>
            <InputFile id="profile-photo-input" class="form-control" accept="@AcceptTypes" OnChange="OnFileSelectedAsync"
                       disabled="@IsBusy" />
            <div class="form-text">JPEG, PNG, or WebP. Maximum size 10 MB.</div>
        </div>
        @if (!string.IsNullOrEmpty(CancelUrl))
        {
            <div class="photo-editor-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelPhoto" disabled="@IsBusy">
                    Cancel
                </button>
            </div>
        }
    }
    else
    {
        <section class="photo-crop-workspace" aria-labelledby="photo-crop-heading">
            <div class="photo-crop-copy">
                <h2 id="photo-crop-heading">Frame your photo</h2>
                <p>Move and resize the image until the circular frame shows the avatar you want.</p>
            </div>

            <div class="profile-photo-cropper-frame">
                <NovaCropperComponent @ref="_cropper" Class="profile-photo-cropper" Src="@ImageDataUrl"
                                      Options="_cropperOptions" />
            </div>
        </section>

        <div class="photo-editor-actions">
            <button type="button" class="btn btn-primary" @onclick="SavePhotoAsync" disabled="@IsBusy">
                @if (IsBusy)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                }
                Save photo
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ChooseDifferentPhoto" disabled="@IsBusy">
                Choose a different photo
            </button>
            @if (!string.IsNullOrEmpty(CancelUrl))
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelPhoto" disabled="@IsBusy">
                    Cancel
                </button>
            }
        </div>
    }
</div>
