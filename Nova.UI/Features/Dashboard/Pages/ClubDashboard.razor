@page "/dashboard"
@rendermode InteractiveAuto
@attribute [Authorize(Policy = Policies.RequireClubMember)]
@using Microsoft.AspNetCore.Authorization
@using Nova.Shared.Enums
@using Nova.Shared.Features.Clubs
@using Nova.Shared.Security
@using Nova.UI.Features.Dashboard

<PageTitle>Dashboard</PageTitle>

<!--
THESIS: The dashboard is today's club directory, not a wall of interchangeable summary cards.
OWN-WORLD: A pale field sheet, enamel route headers, compact roster strips, ink type, and restrained kelp/gold state.
STORY: Staff see active campaigns first, route into work, then scan club capacity and recent movement.
FIRST VIEWPORT: A compact title line sits above active campaigns; club status and attention form a narrower right rail.
FORM: Campaign map, ranked 1; two-zone operations-board staging; seed key assigned.
-->
<div class="dashboard-field py-4">
    <header class="dashboard-heading">
        <div>
            <h1>Club operations</h1>
            <p>Campaigns, roster capacity, and decisions that need a clear next step.</p>
        </div>
        @if (_isClubAdmin)
        {
            <a class="btn btn-primary" href="campaigns/new">
                <span class="bi bi-plus-lg" aria-hidden="true"></span>
                New campaign
            </a>
        }
    </header>

    @if (_isLoading)
    {
        <div class="dashboard-loading" role="status" aria-live="polite">
            <span class="dashboard-loading-line dashboard-loading-line-wide"></span>
            <span class="dashboard-loading-line"></span>
            <span class="visually-hidden">Loading dashboard...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>@_pageError</span>
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else if (_summary is not null)
    {
        <div class="dashboard-grid">
            <section class="operations-board" aria-labelledby="active-campaigns-heading">
                <div class="section-heading">
                    <div>
                        <h2 id="active-campaigns-heading">Active campaigns</h2>
                        <p>Open a workspace to evaluate players and resolve placements.</p>
                    </div>
                    <a class="section-link" href="campaigns">All campaigns <span aria-hidden="true">→</span></a>
                </div>
                @if (_summary.ActiveCampaigns.Count == 0)
                {
                    @if (_isClubAdmin)
                    {
                        <div class="dashboard-empty">
                            <span class="bi bi-signpost-split" aria-hidden="true"></span>
                            <div>
                                <h3>Create your first campaign</h3>
                                <p>Create a campaign to enroll active players and begin evaluations.</p>
                                <a class="btn btn-primary" href="campaigns/new">Create campaign</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active campaigns right now. Check back once an administrator creates one.</p>
                    }
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table campaign-directory align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Participants</th>
                                    <th scope="col">Unresolved</th>
                                    <th scope="col" class="text-end">Workspace</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in _summary.ActiveCampaigns)
                                {
                                    <tr>
                                        <td><strong>@card.Name</strong></td>
                                        <td>@card.ParticipantCount</td>
                                        <td><span class="attention-count@(card.UnresolvedCount > 0 ? null : " is-zero")">@card.UnresolvedCount</span></td>
                                        <td class="text-end">
                                            <a class="workspace-link" href="@card.WorkspaceUrl" aria-label="Open workspace for @card.Name">Open workspace <span aria-hidden="true">→</span></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <aside class="dashboard-sidebar" aria-label="Club summary">
                <section class="status-panel">
                    <div class="section-heading">
                        <h2>Club status</h2>
                    </div>
                    <a class="status-row" href="players">
                        <span class="status-icon bi bi-people" aria-hidden="true"></span>
                        <span>
                            <strong>Roster</strong>
                            <small>@_summary.Roster.ActivePlayers active · @_summary.Roster.ArchivedPlayers archived</small>
                        </span>
                        <span aria-hidden="true">→</span>
                    </a>
                    <a class="status-row" href="@ClubRoutes.Teams">
                        <span class="status-icon bi bi-shield" aria-hidden="true"></span>
                        <span>
                            <strong>Teams</strong>
                            <small>@_summary.Teams.ActiveTeams active · @_summary.Teams.ArchivedTeams archived</small>
                        </span>
                        <span aria-hidden="true">→</span>
                    </a>
                </section>

                @if (_attention is not null)
                {
                    <section class="attention-panel">
                        <div class="section-heading">
                            <h2>Admin attention</h2>
                        </div>
                        @if (_attention.PendingJoinRequests.Status == AttentionRegionStatus.Loaded)
                        {
                            <p><strong>@_attention.PendingJoinRequests.Count</strong> pending join requests</p>
                            <a href="@ReviewRequestsUrl">Review requests <span aria-hidden="true">→</span></a>
                        }
                        else
                        {
                            <p class="text-muted">Pending join requests unavailable.</p>
                        }
                        @if (_attention.NeedsPlacement.Status == AttentionRegionStatus.Loaded)
                        {
                            <p><strong>@_attention.NeedsPlacement.Count</strong> unresolved placements</p>
                            <a href="@ReviewPlacementsUrl">Review placements <span aria-hidden="true">→</span></a>
                        }
                        else
                        {
                            <p class="text-muted">Unresolved placements unavailable.</p>
                        }
                    </section>
                }
            </aside>
        </div>

        <section class="activity-board" aria-labelledby="recent-activity-heading">
            <div class="section-heading">
                <div>
                    <h2 id="recent-activity-heading">Recent activity</h2>
                    <p>The latest recorded movement across your club.</p>
                </div>
            </div>
            @if (_activity is null || _activity.Events.Count == 0)
            {
                <p class="text-muted mb-0">No recent activity.</p>
            }
            else
            {
                <ul class="activity-list">
                    @foreach (var item in _activity.Events)
                    {
                        <li>
                            <time>@DashboardDisplay.FormatActivityDate(item.OccurredAt)</time>
                            <span>
                                @if (item.ActorDisplayName is string actorName)
                                {
                                    @($"{actorName} {DashboardDisplay.ActivityVerb(item)}")
                                }
                                else
                                {
                                    @DashboardDisplay.ActivityVerb(item)
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
