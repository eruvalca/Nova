<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-Nova-ff5614db-51cf-4f78-a241-602e7627a567</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <ProjectReference Include="..\Nova.ServiceDefaults\Nova.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Nova.Client\Nova.Client.csproj" />
    <ProjectReference Include="..\Nova.Shared\Nova.Shared.csproj" />
    <ProjectReference Include="..\Nova.UI\Nova.UI.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!-- Sass sources for the kelp-forest Bootstrap theme (issue #132). Referenced from the
       BuildBootstrapTheme target's Inputs so MSBuild can evaluate incrementality. -->
  <ItemGroup>
    <ThemeScssFiles Include="scss\**\*.scss" />
  </ItemGroup>

  <!--
    Builds the kelp-forest Bootstrap theme from the Sass sources in scss/ into
    wwwroot/css/bootstrap-theme.css. The compiled output is gitignored and is
    regenerated on every build (incrementally: the target reruns only when the
    Sass sources or the lockfile change). `npm ci` runs only once, when the
    node_modules folder is missing; subsequent builds reuse the installed tree.

    This target must run BEFORE static-web-asset discovery. The compiled CSS is
    gitignored, so on a clean checkout it does not exist when the SDK evaluates the
    default wwwroot/** glob into @(Content). If the target ran after discovery (e.g.
    BeforeTargets="Build" while discovery happens in BeforeTargets="AssignTargetPaths"),
    @Assets["css/bootstrap-theme.css"] would resolve to nothing and the <link> would 404.
    Hooking into ResolveProjectStaticWebAssets (the target that consumes @(Content) to
    detect wwwroot assets) ensures the file exists on disk AND is registered as a Content
    item before discovery runs.
  -->
  <Target Name="BuildBootstrapTheme" BeforeTargets="ResolveProjectStaticWebAssets"
          Inputs="@(ThemeScssFiles);$(MSBuildProjectDirectory)\package.json"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\css\bootstrap-theme.css;$(MSBuildProjectDirectory)\wwwroot\css\fonts\bootstrap-icons.woff2;$(MSBuildProjectDirectory)\wwwroot\css\fonts\bootstrap-icons.woff">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition="!Exists('$(MSBuildProjectDirectory)\node_modules')" />
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="wwwroot\css\bootstrap-theme.css"
               Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\css\bootstrap-theme.css')" />
      <FileWrites Include="$(MSBuildProjectDirectory)\wwwroot\css\bootstrap-theme.css" />
    </ItemGroup>
    <!--
      Copy the bootstrap-icons font files next to the compiled theme so the
      `@font-face` in bootstrap-theme.css (which references
      `./fonts/bootstrap-icons.woff2`) resolves under static-web-asset serving.
      The fonts are generated from node_modules, so they are registered as
      Content for static-web-asset discovery and as FileWrites for clean.
    -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\node_modules\bootstrap-icons\font\fonts\bootstrap-icons.woff2;
                        $(MSBuildProjectDirectory)\node_modules\bootstrap-icons\font\fonts\bootstrap-icons.woff"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\css\fonts" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot\css\fonts\bootstrap-icons.woff2;wwwroot\css\fonts\bootstrap-icons.woff"
               Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\css\fonts\bootstrap-icons.woff2')" />
      <FileWrites Include="$(MSBuildProjectDirectory)\wwwroot\css\fonts\bootstrap-icons.woff2;
                           $(MSBuildProjectDirectory)\wwwroot\css\fonts\bootstrap-icons.woff" />
    </ItemGroup>
  </Target>

</Project>
