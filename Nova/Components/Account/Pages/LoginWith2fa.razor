@page "/Account/LoginWith2fa"

@layout AuthLayout

<!--
THESIS: This account task belongs to the shared Hall of Panels access experience.
OWN-WORLD: Matte directory signs lead to one paper-white working board with precise hairlines.
STORY: The member confirms their account area, reads the task heading, then completes or acknowledges the operation.
FIRST VIEWPORT: The active directory panel and the page task heading establish location and purpose.
FORM: Hall of Panels, ranked 1; surface seed a3b942a9; the shared static-SSR shell owns the directory and board.
-->

<PageTitle>Two-factor authentication</PageTitle>

<h1>Two-factor authentication</h1>
<hr />
<StatusMessage Message="@message" />
<p>Your login is protected with an authenticator app. Enter your authenticator code below.</p>
<div class="row">
    <div class="col-md-4">
        <EditForm class="auth-form" Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            <AccountFormField For="() => Input.TwoFactorCode" FieldId="Input.TwoFactorCode" Label="Authenticator code">
                <InputText @bind-Value="Input.TwoFactorCode" id="Input.TwoFactorCode" class="form-control"
                           autocomplete="off" />
            </AccountFormField>
            <div class="checkbox mb-3">
                <label for="remember-machine" class="form-label">
                    <InputCheckbox @bind-Value="Input.RememberMachine" />
                    Remember this machine
                </label>
            </div>
            <div>
                <AccountSubmitButton Text="Log in" />
            </div>
        </EditForm>
    </div>
</div>
<p>
    Don't have access to your authenticator device? You can
    <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl">log in with a recovery code</a>.
</p>
