@page "/Account/Login"

@layout AuthLayout

<!--
THESIS: This account task belongs to the shared Hall of Panels access experience.
OWN-WORLD: Matte directory signs lead to one paper-white working board with precise hairlines.
STORY: The member confirms their account area, reads the task heading, then completes or acknowledges the operation.
FIRST VIEWPORT: The active directory panel and the page task heading establish location and purpose.
FORM: Hall of Panels, ranked 1; surface seed a3b942a9; the shared static-SSR shell owns the directory and board.
-->

<PageTitle>Log in</PageTitle>

<h1>Log in</h1>
<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm class="auth-form" EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2>Use a local account to log in.</h2>
                <hr />
                <ValidationSummary class="alert alert-danger" role="alert" />
                <AccountFormField For="() => Input.Email" FieldId="Input.Email" Label="Email">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control"
                               autocomplete="username webauthn" aria-required="true" placeholder="name@example.com" />
                </AccountFormField>
                <AccountFormField For="() => Input.Password" FieldId="Input.Password" Label="Password">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control"
                               autocomplete="current-password" aria-required="true" placeholder="password" />
                </AccountFormField>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Remember me
                    </label>
                </div>
                <div>
                    <AccountSubmitButton Text="Log in" />
                </div>
                <hr />
                <div class="d-flex flex-column">
                    <span class="text-secondary mx-auto mt-2">OR</span>
                    <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email"
                                   class="btn btn-link mx-auto">Log in with a passkey</PasskeySubmit>
                </div>
                <hr />
                <div class="auth-actions">
                    <a href="Account/ForgotPassword">Forgot your password?</a>
                    <a href="@RegisterUrl">Register as a new user</a>
                    <a href="Account/ResendEmailConfirmation">Resend email confirmation</a>
                </div>
            </EditForm>
            </section>
        </div>
        <div class="col-lg-4 col-lg-offset-2">
            <section>
                <h3>Use another service to log in.</h3>
                <hr />
                <ExternalLoginPicker />
            </section>
        </div>
    </div>
