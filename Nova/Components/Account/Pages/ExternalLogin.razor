@page "/Account/ExternalLogin"

@layout AuthLayout

<!--
THESIS: This account task belongs to the shared Hall of Panels access experience.
OWN-WORLD: Matte directory signs lead to one paper-white working board with precise hairlines.
STORY: The member confirms their account area, reads the task heading, then completes or acknowledges the operation.
FIRST VIEWPORT: The active directory panel and the page task heading establish location and purpose.
FORM: Hall of Panels, ranked 1; surface seed a3b942a9; the shared static-SSR shell owns the directory and board.
-->

<PageTitle>Register</PageTitle>

<StatusMessage Message="@message" />
<h1>Register</h1>
<h2>Associate your @ProviderDisplayName account.</h2>
<hr />

<div class="alert alert-info">
    You've successfully authenticated with <strong>@ProviderDisplayName</strong>.
    Please enter an email address for this site below and click the Register button to finish
    logging in.
</div>

<div class="row">
    <div class="col-md-4">
        <EditForm class="auth-form" Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="confirmation" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            <AccountFormField For="() => Input.Email" FieldId="Input.Email" Label="Email">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="email"
                           placeholder="Please enter your email." />
            </AccountFormField>
            <AccountSubmitButton Text="Register" />
        </EditForm>
    </div>
</div>
