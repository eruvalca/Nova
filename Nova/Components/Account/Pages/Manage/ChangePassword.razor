@page "/Account/Manage/ChangePassword"

<!--
THESIS: Password management is a quiet security desk for replacing the current credential without leaving the account hall.
OWN-WORLD: Ink-dark hierarchy, paper-white fields, precise hairlines, and one teal update action.
STORY: The member confirms the old password, enters a new one twice, and receives the existing Identity status feedback.
FIRST VIEWPORT: The Change password heading names the operation before the first credential field begins.
FORM: One static-SSR form preserves the existing form name, validation, antiforgery, refresh-sign-in, and redirect contract.
-->

<PageTitle>Change password</PageTitle>

<div class="manage-page manage-password">
    <header class="manage-page-heading">
        <h1>Change password</h1>
        <p>Update the password used to sign in to your Nova account.</p>
    </header>

    <StatusMessage Message="@message" />
    <EditForm class="manage-page-form" Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />
        <AccountFormField For="() => Input.OldPassword" FieldId="Input.OldPassword" Label="Old password">
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control"
                           autocomplete="current-password" aria-required="true" placeholder="Enter the old password" />
        </AccountFormField>
        <AccountFormField For="() => Input.NewPassword" FieldId="Input.NewPassword" Label="New password"
                          HelpText="Use at least 6 characters.">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control"
                           autocomplete="new-password" aria-required="true" placeholder="Enter the new password" />
        </AccountFormField>
        <AccountFormField For="() => Input.ConfirmPassword" FieldId="Input.ConfirmPassword" Label="Confirm password">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password" aria-required="true"
                           placeholder="Enter the new password" />
        </AccountFormField>
        <AccountSubmitButton Text="Update password" />
    </EditForm>
</div>
