@page "/Account/Manage/Disable2fa"

<!--
THESIS: Disabling two-factor authentication is a consequential security change, so the board states exactly what it does and does not change.
OWN-WORLD: Flat warning board, direct security language, hairline layout, and one restrained danger action.
STORY: The member reviews the effect on sign-in protection, then confirms the existing disable operation.
FIRST VIEWPORT: The heading and warning precede the form so the consequence is understood before action.
FORM: The disable-2fa post keeps its existing name, antiforgery token, handler, method, and status/redirect behavior.
-->

<PageTitle>Disable two-factor authentication (2FA)</PageTitle>

<div class="manage-page manage-disable-two-factor">
    <header class="manage-page-heading">
        <h1>Disable two-factor authentication (2FA)</h1>
        <p>Review the effect before removing this extra sign-in protection.</p>
    </header>

    <StatusMessage />
    <div class="manage-board alert alert-warning" role="alert">
        <p><strong>This action only disables 2FA.</strong></p>
        <p>Disabling 2FA does not change the keys used in authenticator apps. To change that key, <a href="Account/Manage/ResetAuthenticator">reset your authenticator keys</a>.</p>
    </div>
    <div class="manage-actions">
        <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Disable 2FA</button>
        </form>
    </div>
</div>
