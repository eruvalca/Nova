@page "/Account/Manage/EnableAuthenticator"

<!--
THESIS: Authenticator setup is a guided station: each step moves from app choice to scan to a confirming code.
OWN-WORLD: A flat instruction board with readable sequence markers, semantic alerts, and one clear verification action.
STORY: The member installs an app, scans or types the shared key, then proves the app is working with a current code.
FIRST VIEWPORT: The setup heading and first step establish the sequence before the QR workspace and form.
FORM: The send-code EditForm keeps its existing name, Input.Code binding, antiforgery/validation pipeline, QR data-url hook, and recovery-code handoff.
-->

<PageTitle>Configure authenticator app</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <div class="manage-page manage-authenticator">
        <header class="manage-page-heading">
            <h1>Configure authenticator app</h1>
            <p>Follow the three steps below to add a verification app to your account.</p>
        </header>

        <StatusMessage Message="@message" />
        <ol class="manage-board manage-step-list">
            <li>
                <h2>Download an authenticator app</h2>
                <p>
                    Choose an app like Microsoft Authenticator for
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> and
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>, or Google Authenticator for
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> and
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
                </p>
            </li>
            <li>
                <h2>Scan the QR code</h2>
                <p>Scan the QR code or enter this key <kbd>@sharedKey</kbd> into your authenticator app. Spaces and casing do not matter.</p>
                <div class="alert alert-info" role="note">Learn how to <a href="https://go.microsoft.com/fwlink/?Linkid=852423">enable QR code generation</a>.</div>
                <div data-url="@authenticatorUri"></div>
            </li>
            <li>
                <h2>Confirm the app code</h2>
                <p>Enter the unique code shown by your authenticator app in the confirmation box below.</p>
                <EditForm class="manage-page-form" Model="Input" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post">
                    <DataAnnotationsValidator />
                    <AccountFormField For="() => Input.Code" FieldId="Input.Code" Label="Verification code">
                        <InputText @bind-Value="Input.Code" id="Input.Code" class="form-control" autocomplete="off" placeholder="Enter the code" />
                    </AccountFormField>
                    <ValidationSummary class="alert alert-danger" role="alert" />
                    <AccountSubmitButton Text="Verify" />
                </EditForm>
            </li>
        </ol>
    </div>
}
