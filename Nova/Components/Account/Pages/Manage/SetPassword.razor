@page "/Account/Manage/SetPassword"

<!--
THESIS: Set-password is a vestigial credential station for accounts without a local password, kept reachable without inventing an external-login path.
OWN-WORLD: A calm working sheet, direct security copy, hairline fields, and one teal set action.
STORY: The member reads why this station exists, enters a password twice, and keeps the existing sign-in refresh behavior.
FIRST VIEWPORT: The Set your password heading and explanation establish the rare account state before the form.
FORM: One static-SSR form preserves its name, validation, antiforgery, status message, and redirect behavior.
-->

<PageTitle>Set password</PageTitle>

<div class="manage-page manage-set-password">
    <header class="manage-page-heading">
        <h1>Set your password</h1>
        <p>You do not have a local username and password for this site. Add a local credential for sign-in.</p>
    </header>

    <StatusMessage Message="@message" />
    <EditForm class="manage-page-form" Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" role="alert" />
        <AccountFormField For="() => Input.NewPassword" FieldId="Input.NewPassword" Label="New password"
                          HelpText="Use at least 6 characters.">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control"
                           autocomplete="new-password" placeholder="Enter the new password" />
        </AccountFormField>
        <AccountFormField For="() => Input.ConfirmPassword" FieldId="Input.ConfirmPassword" Label="Confirm password">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password" placeholder="Enter the new password" />
        </AccountFormField>
        <AccountSubmitButton Text="Set password" />
    </EditForm>
</div>
