@page "/Account/Manage/Passkeys"

@using System.Buffers.Text

<!--
THESIS: Passkeys are a device-credential register: the board shows what is connected and gives each credential a precise next action.
OWN-WORLD: Flat table board, quiet row separators, touch-sized controls, and a single teal add action.
STORY: The member reviews registered passkeys, renames or removes one, or starts the existing browser passkey creation flow.
FIRST VIEWPORT: The heading and current list state explain whether there is anything to manage before the add control.
FORM: Per-passkey update forms and the add-passkey form preserve their generated names, hidden CredentialId, Action values, antiforgery tokens, and PasskeySubmit contract.
-->

<PageTitle>Manage your passkeys</PageTitle>

<div class="manage-page manage-passkeys">
    <header class="manage-page-heading">
        <h1>Manage your passkeys</h1>
        <p>Use a device credential to sign in without a password.</p>
    </header>

    <StatusMessage />
    <section class="manage-board" aria-labelledby="registered-passkeys-heading">
        <h2 id="registered-passkeys-heading">Registered passkeys</h2>
        @if (currentPasskeys is { Count: > 0 })
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var passkey in currentPasskeys)
                        {
                            <tr>
                                <td>@(passkey.Name ?? "Unnamed passkey")</td>
                                <td>
                                    @{
                                        var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                                    }
                                    <form class="manage-passkey-actions" @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskey" method="post">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="CredentialId" value="@credentialId" />
                                        <button type="submit" name="Action" value="rename" class="btn btn-outline-secondary" title="Rename this passkey">Rename</button>
                                        <button type="submit" name="Action" value="delete" class="btn btn-outline-danger" title="Remove this passkey from your account">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No passkeys are registered.</p>
        }
    </section>

    <section class="manage-board" aria-labelledby="add-passkey-heading">
        <h2 id="add-passkey-heading">Add a passkey</h2>
        <form @formname="add-passkey" @onsubmit="AddPasskey" method="post">
            <AntiforgeryToken />
            @if (currentPasskeys is { Count: >= MaxPasskeyCount })
            {
                <p class="text-danger">You have reached the maximum number of allowed passkeys. Please delete one before adding a new one.</p>
            }
            else
            {
                <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn btn-primary">Add a new passkey</PasskeySubmit>
            }
        </form>
    </section>
</div>
