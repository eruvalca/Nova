@page "/Account/Manage/ExternalLogins"

<!--
THESIS: External logins are a connection register: the member can see what is linked and which providers remain available.
OWN-WORLD: Flat boards, clear provider rows, hairline separators, and quiet remove/link actions.
STORY: The member reviews registered services, removes an existing connection when allowed, or links another provider.
FIRST VIEWPORT: The heading and current connection state appear before provider actions.
FORM: Remove and link forms preserve their generated names, hidden provider fields, antiforgery tokens, action URL, method, and handler contract.
-->

<PageTitle>Manage your external logins</PageTitle>

<div class="manage-page manage-external-logins">
    <header class="manage-page-heading">
        <h1>Manage your external logins</h1>
        <p>Review the services connected to your Nova account.</p>
    </header>

    <StatusMessage />
    @if (currentLogins?.Count > 0)
    {
        <section class="manage-board" aria-labelledby="registered-logins-heading">
            <h2 id="registered-logins-heading">Registered logins</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Service</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var login in currentLogins)
                        {
                            <tr>
                                <td>@login.ProviderDisplayName</td>
                                <td>
                                    @if (showRemoveButton)
                                    {
                                        <form class="manage-login-actions" @formname="@($"remove-login-{login.LoginProvider}")" @onsubmit="OnSubmitAsync" method="post">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="@nameof(LoginProvider)" value="@login.LoginProvider" />
                                            <input type="hidden" name="@nameof(ProviderKey)" value="@login.ProviderKey" />
                                            <button type="submit" class="btn btn-outline-danger" title="Remove this @login.ProviderDisplayName login from your account">Remove</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">Required sign-in</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    @if (otherLogins?.Count > 0)
    {
        <section class="manage-board" aria-labelledby="available-logins-heading">
            <h2 id="available-logins-heading">Add another service</h2>
            <p>Link another provider so it can be used to sign in.</p>
            <form action="Account/Manage/LinkExternalLogin" method="post">
                <AntiforgeryToken />
                <div class="manage-actions">
                    @foreach (var provider in otherLogins)
                    {
                        <button type="submit" class="btn btn-primary" name="Provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                    }
                </div>
            </form>
        </section>
    }
</div>
