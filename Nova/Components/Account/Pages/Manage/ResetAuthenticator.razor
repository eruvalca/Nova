@page "/Account/Manage/ResetAuthenticator"

<!--
THESIS: Resetting an authenticator key is a deliberate security change, so the warning and consequence lead the working board.
OWN-WORLD: Flat warning board, direct copy, hairline layout, and a restrained danger action.
STORY: The member understands the temporary 2FA gap, then confirms the reset with the existing post.
FIRST VIEWPORT: The heading and warning explain the risk before the reset control appears.
FORM: The reset-authenticator post keeps its existing form name, antiforgery token, handler, method, and redirect behavior.
-->

<PageTitle>Reset authenticator key</PageTitle>

<div class="manage-page manage-authenticator-reset">
    <header class="manage-page-heading">
        <h1>Reset authenticator key</h1>
        <p>Replace the key used by your authenticator app.</p>
    </header>

    <StatusMessage />
    <div class="manage-board alert alert-warning" role="alert">
        <p><strong>If you reset your authenticator key, your authenticator app will not work until you reconfigure it.</strong></p>
        <p>This process disables 2FA until you verify your authenticator app. If you do not complete configuration, you may lose access to your account.</p>
    </div>
    <div class="manage-actions">
        <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Reset authenticator key</button>
        </form>
    </div>
</div>
