@page "/Account/Manage/DeletePersonalData"

<!--
THESIS: Account deletion is a guarded exit: the page explains the exact club consequence before asking for confirmation.
OWN-WORLD: Flat warning boards, direct language, semantic danger actions, and interactive confirmation only where the scenario requires it.
STORY: The member waits for the deletion preview, resolves sole-admin ownership when needed, or confirms deletion with the existing password/modal flow.
FIRST VIEWPORT: The heading and scenario-specific consequence lead the page before the destructive form.
FORM: The delete-user EditForm, id, password binding, antiforgery/validation, modal target, child islands, and post handler remain unchanged.
-->

<PageTitle>Delete personal data</PageTitle>

<div class="manage-page manage-delete-personal-data">
    <header class="manage-page-heading">
        <h1>Delete personal data</h1>
        <p>This is permanent. Review the impact on your account and club data before continuing.</p>
    </header>

    <StatusMessage Message="@message" />

    @if (_preview is null)
    {
        <p class="text-muted">Loading…</p>
    }
    else if (_preview.Scenario == AccountDeletionScenario.SoleClubAdmin)
    {
        <div class="manage-board alert alert-warning" role="alert">
            <p><strong>You are the only admin of @_preview.ClubName.</strong> Before you can delete your account, you must assign another club admin.</p>
        </div>
        <AssignClubAdminPanel @rendermode="InteractiveAuto" />
    }
    else
    {
        @* Scenario A (NoClubOrNonAdmin) and Scenario B (OnlyClubMember) both show the form *@
        @if (_preview.Scenario == AccountDeletionScenario.OnlyClubMember)
        {
            <div class="manage-board alert alert-danger" role="alert">
                <p><strong>Warning:</strong> You are the only member of <strong>@_preview.ClubName</strong>. Deleting your account will permanently delete this club and all of its data — including players, teams, campaigns, seasons, notes, tags, and photos.</p>
            </div>
        }
        else
        {
            <div class="manage-board alert alert-warning" role="alert">
                <p><strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong></p>
            </div>
        }

        <EditForm class="manage-page-form" Model="Input" FormName="delete-user" id="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            @if (requirePassword)
            {
                <AccountFormField For="() => Input.Password" FieldId="Input.Password" Label="Password">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                </AccountFormField>
            }
            @if (_preview.Scenario == AccountDeletionScenario.OnlyClubMember)
            {
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirm-delete-modal">Delete data and close my account</button>
                <ConfirmDeleteDialog @rendermode="InteractiveAuto" ClubName="@(_preview.ClubName!)" FormId="delete-user" />
            }
            else
            {
                <button class="btn btn-danger" type="submit">Delete data and close my account</button>
            }
        </EditForm>
    }
</div>
