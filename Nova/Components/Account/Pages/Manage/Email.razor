@page "/Account/Manage/Email"

<!--
THESIS: Email management is the account hall's address desk, separating current verification state from a requested change.
OWN-WORLD: A flat working sheet, labeled state language, hairline fields, and one teal change action.
STORY: The member checks the current address, sends verification when needed, or submits a new address for confirmation.
FIRST VIEWPORT: The Email heading and confirmation state explain what can happen before the first field receives focus.
FORM: Two static-SSR posts retain their existing names, antiforgery tokens, validation, status feedback, and redirects.
-->

<PageTitle>Manage email</PageTitle>

<div class="manage-page manage-email">
    <header class="manage-page-heading">
        <h1>Manage email</h1>
        <p>Keep the address on your account current and confirm changes through the existing email flow.</p>
    </header>

    <StatusMessage Message="@message" />
    <section class="manage-board manage-email-board" aria-labelledby="email-details-heading">
        <h2 id="email-details-heading">Email details</h2>
        <form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form"
              method="post">
            <AntiforgeryToken />
        </form>
        <EditForm class="manage-page-form" Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            @if (isEmailConfirmed)
            {
                <div class="account-identity-field mb-3">
                    <AccountFormLabel For="email" Text="Email" />
                    <input type="text" value="@email" id="email" class="form-control" placeholder="Enter your email"
                           disabled />
                    <div class="form-text text-success-emphasis">Confirmed email address.</div>
                </div>
            }
            else
            {
                <div class="account-identity-field mb-3">
                    <AccountFormLabel For="email" Text="Email" />
                    <input type="text" value="@email" id="email" class="form-control" placeholder="Enter your email"
                           disabled />
                    <div class="manage-inline-action">
                        <button type="submit" class="btn btn-outline-secondary" form="send-verification-form">Send verification email</button>
                    </div>
                </div>
            }
            <AccountFormField For="() => Input.NewEmail" FieldId="Input.NewEmail" Label="New email"
                              HelpText="Changing your email sends a confirmation link to the new address.">
                    <InputText @bind-Value="Input.NewEmail" id="Input.NewEmail" class="form-control" autocomplete="email"
                               aria-required="true" placeholder="Enter a new email" />
            </AccountFormField>
            <AccountSubmitButton Text="Change email" />
        </EditForm>
    </section>
</div>
