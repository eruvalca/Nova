@page "/Account/Manage/GenerateRecoveryCodes"

<!--
THESIS: Recovery-code generation is a safety station that makes the irreversible replacement step explicit.
OWN-WORLD: Flat warning board, readable consequence copy, hairline boundaries, and one deliberate danger action.
STORY: The member learns what changes, confirms generation, and then receives the existing one-time recovery-code display.
FIRST VIEWPORT: The heading and warning are visible before the generation control.
FORM: The generate-recovery-codes post keeps its existing name, antiforgery token, handler, method, and ShowRecoveryCodes handoff.
-->

<PageTitle>Generate two-factor authentication (2FA) recovery codes</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <div class="manage-page manage-recovery-codes">
        <header class="manage-page-heading">
            <h1>Generate 2FA recovery codes</h1>
            <p>Replace your current recovery codes with a new set for account recovery.</p>
        </header>

        <div class="manage-board alert alert-warning" role="alert">
            <p><strong>Put these codes in a safe place.</strong></p>
            <p>If you lose your device and do not have the recovery codes, you will lose access to your account.</p>
            <p>Generating new recovery codes does not change the keys used in authenticator apps. To change that key, <a href="Account/Manage/ResetAuthenticator">reset your authenticator keys</a>.</p>
        </div>
        <div class="manage-actions">
            <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
                <AntiforgeryToken />
                <button class="btn btn-danger" type="submit">Generate recovery codes</button>
            </form>
        </div>
    </div>
}
