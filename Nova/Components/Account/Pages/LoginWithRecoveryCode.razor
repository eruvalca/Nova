@page "/Account/LoginWithRecoveryCode"

@layout AuthLayout

<!--
THESIS: This account task belongs to the shared Hall of Panels access experience.
OWN-WORLD: Matte directory signs lead to one paper-white working board with precise hairlines.
STORY: The member confirms their account area, reads the task heading, then completes or acknowledges the operation.
FIRST VIEWPORT: The active directory panel and the page task heading establish location and purpose.
FORM: Hall of Panels, ranked 1; surface seed a3b942a9; the shared static-SSR shell owns the directory and board.
-->

<PageTitle>Recovery code verification</PageTitle>

<h1>Recovery code verification</h1>
<hr />
<StatusMessage Message="@message" />
<p>
    You have requested to log in with a recovery code. This login will not be remembered until you provide
    an authenticator app code at log in or disable 2FA and log in again.
</p>
<div class="row">
    <div class="col-md-4">
        <EditForm class="auth-form" Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />
            <AccountFormField For="() => Input.RecoveryCode" FieldId="Input.RecoveryCode" Label="Recovery Code">
                <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" class="form-control"
                           autocomplete="off" placeholder="RecoveryCode" />
            </AccountFormField>
            <AccountSubmitButton Text="Log in" />
        </EditForm>
    </div>
</div>
