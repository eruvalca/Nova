@page "/Account/ResetPassword"

@layout AuthLayout

<!--
THESIS: This account task belongs to the shared Hall of Panels access experience.
OWN-WORLD: Matte directory signs lead to one paper-white working board with precise hairlines.
STORY: The member confirms their account area, reads the task heading, then completes or acknowledges the operation.
FIRST VIEWPORT: The active directory panel and the page task heading establish location and purpose.
FORM: Hall of Panels, ranked 1; surface seed a3b942a9; the shared static-SSR shell owns the directory and board.
-->

<PageTitle>Reset password</PageTitle>

<h1>Reset password</h1>
<h2>Reset your password.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <StatusMessage Message="@Message" />
        <EditForm class="auth-form" Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" role="alert" />

            <input type="hidden" name="Input.Code" value="@Input.Code" />
            <AccountFormField For="() => Input.Email" FieldId="Input.Email" Label="Email">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username"
                           aria-required="true" placeholder="name@example.com" />
            </AccountFormField>
            <AccountFormField For="() => Input.Password" FieldId="Input.Password" Label="Password">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control"
                           autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
            </AccountFormField>
            <AccountFormField For="() => Input.ConfirmPassword" FieldId="Input.ConfirmPassword" Label="Confirm password">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword"
                           class="form-control" autocomplete="new-password" aria-required="true"
                           placeholder="Please confirm your password." />
            </AccountFormField>
            <AccountSubmitButton Text="Reset" />
        </EditForm>
    </div>
</div>
