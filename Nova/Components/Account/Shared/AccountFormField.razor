@typeparam TValue
@* Shared account form field: label, control slot, validation message, and optional help text.
   The label is rendered only when both Label and FieldId are present, so the label is always
   programmatically associated with a control (an empty for="" would break the association). *@
<div class="account-form-field mb-3">
    @if (!string.IsNullOrEmpty(Label) && !string.IsNullOrEmpty(FieldId))
    {
        <AccountFormLabel For="@FieldId" Text="@Label" Optional="@Optional" />
    }
    @ChildContent
    <AccountValidationMessage For="@For" />
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="form-text">@HelpText</div>
    }
</div>
