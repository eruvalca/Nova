@if (externalLogins.Length == 0)
{
    <div class="account-external-empty">
        <p>
            There are no external authentication services configured. See this <a
            href="https://go.microsoft.com/fwlink/?LinkID=532715">article
            about setting up this ASP.NET application to support logging in via external services</a>.
        </p>
    </div>
}
else
{
    <form class="account-external-picker" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <div class="d-grid gap-2">
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name"
                            title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                }
            </div>
        </div>
    </form>
}
