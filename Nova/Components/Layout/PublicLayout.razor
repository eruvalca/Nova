@inherits LayoutComponentBase

<!--
THESIS: Nova turns a scattered tryout into one legible route, refusing the generic software hero and feature-card grid.
OWN-WORLD: Pale field sheets, kelp enamel signs, ink-dark type, gold attention marks, and roster-rule hairlines.
STORY: Visitors see the full campaign route, understand how staff share it, then create a club.
FIRST VIEWPORT: Copy and actions occupy the left; a large working campaign board proves the product on the right.
FORM: Campaign map, ranked 1; operational field-directory staging; seed key assigned.
-->
<header class="public-header sticky-top">
    <nav class="navbar navbar-expand-md navbar-light" aria-label="Public">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <span class="brand-mark" aria-hidden="true"><span></span></span>
                <span class="brand-lockup">
                    <span class="brand-name">Nova</span>
                    <span class="brand-descriptor">Tryout operations</span>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#public-nav"
                    aria-controls="public-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="public-nav">
                <ul class="navbar-nav mx-auto mb-2 mb-md-0">
                    <li class="nav-item">
                        <a class="nav-link" href="#product">Product</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#how-it-works">How it works</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#collaboration">For clubs</a>
                    </li>
                </ul>
                <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
                    <a class="btn btn-outline-primary" href="@SignInUrl">Sign in</a>
                    <a class="btn btn-primary" href="@CreateClubUrl">Create your club</a>
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="public-main" id="main-content">
    @Body
</main>
