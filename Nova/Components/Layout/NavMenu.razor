@using Nova.Shared.Security

<nav class="navbar navbar-expand-md navbar-light nova-navigation @(IsAccountRoutesSingle ? "account-routes-single" : null)" aria-label="Primary">
    <div class="container-fluid nova-navigation-inner">
        <a class="nova-brand" href="/dashboard" aria-label="Nova dashboard">
            <span class="nova-brand-mark" aria-hidden="true"><span></span></span>
            <span class="nova-brand-copy">
                <strong>Nova</strong>
                <span>Club operations</span>
            </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav-menu"
                aria-controls="main-nav-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-nav-menu">
            <ul class="navbar-nav nova-primary-routes me-auto mb-2 mb-md-0">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-2" href="/dashboard" Match="NavLinkMatch.All">
                                <span class="nav-icon-slot">
                                    <span class="bi bi-house nav-icon" aria-hidden="true"></span>
                                    <span class="bi bi-house-fill nav-icon-fill" aria-hidden="true"></span>
                                </span>
                                <span class="nav-label">Dashboard</span>
                            </NavLink>
                        </li>
                        @if (ClubDetailUrl is not null && ClubName is not null)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link d-flex align-items-center gap-2" href="@ClubDetailUrl" Match="NavLinkMatch.Prefix">
                                    @if (context.User.HasClaim(c => c.Type == NovaClaimTypes.HasClubCrest))
                                    {
                                        <span class="nav-avatar-slot">
                                            <img class="nav-avatar" src="@ClubCrestUrl" alt="" aria-hidden="true" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="nav-icon-slot">
                                            <span class="bi bi-building nav-icon" aria-hidden="true"></span>
                                            <span class="bi bi-building-fill nav-icon-fill" aria-hidden="true"></span>
                                        </span>
                                    }
                                    <span class="nav-label">@ClubName</span>
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link d-flex align-items-center gap-2" href="campaigns" Match="NavLinkMatch.Prefix">
                                    <span class="nav-icon-slot">
                                        <span class="bi bi-calendar-check nav-icon" aria-hidden="true"></span>
                                        <span class="bi bi-calendar-check-fill nav-icon-fill" aria-hidden="true"></span>
                                    </span>
                                    <span class="nav-label">Campaigns</span>
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link d-flex align-items-center gap-2" href="players" Match="NavLinkMatch.Prefix">
                                    <span class="nav-icon-slot">
                                        <span class="bi bi-people nav-icon" aria-hidden="true"></span>
                                        <span class="bi bi-people-fill nav-icon-fill" aria-hidden="true"></span>
                                    </span>
                                    <span class="nav-label">Players</span>
                                </NavLink>
                            </li>
                            <li class="nav-item">
                                <NavLink class="nav-link d-flex align-items-center gap-2" href="teams" Match="NavLinkMatch.Prefix">
                                    <span class="nav-icon-slot">
                                        <span class="bi bi-shield nav-icon" aria-hidden="true"></span>
                                        <span class="bi bi-shield-fill nav-icon-fill" aria-hidden="true"></span>
                                    </span>
                                    <span class="nav-label">Teams</span>
                                </NavLink>
                            </li>
                        }
                    </Authorized>
                </AuthorizeView>
            </ul>
            <ul class="navbar-nav nova-account-routes ms-auto mb-2 mb-md-0">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage">
                                @if (context.User.HasClaim(c => c.Type == NovaClaimTypes.HasProfilePhoto))
                                {
                                    <span class="nav-avatar-slot">
                                        <img class="nav-avatar" src="@PhotoUrl" alt="Profile photo" />
                                    </span>
                                }
                                <span class="nav-label">Manage</span>
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@CurrentUrl" />
                                <button type="submit" class="btn nav-link border-0 d-flex align-items-center gap-2">
                                    <span class="nav-icon-slot">
                                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                                    </span>
                                    <span class="nav-label">Logout</span>
                                </button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="Account/Login">Login</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>
